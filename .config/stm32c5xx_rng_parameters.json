{
  "$schema": "http://json-schema.org/draft-07/schema",
  "version": "0.0.1",
  "componentid": "::Device:STM32CubeMX2 Config:RNG",
  "grammarVersion": "3.5",
  "type": "object",
  "properties": {
    "parameters": {
      "type": "object",
      "properties": {
        "info": {
          "type": "object",
          "title": "General information",
          "properties": {
            "labels": {
              "type": "array",
              "title": "Add a label",
              "description": "Labels allow to create aliases inside mx_hal_def.h file like '<label>_init', '<label>_deinit' and '<label>_gethandle'. These aliases can be used on application side.",
              "items": {
                "type": "string",
                "pattern": "^([a-zA-Z_][a-zA-Z0-9_]{1,31})?$",
                "minLength": 0,
                "maxLength": 32,
                "unique": "project",
                "default": ""
              }
            },
            "layer": {
              "type": "string",
              "title": "Software layer",
              "oneOf": [
                {
                  "title": "HAL",
                  "const": "HAL"
                },
                {
                  "title": "LL",
                  "const": "LL"
                }
              ],
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_RNG_PROJECT_USE_HAL",
                  "condition": "$value === 'HAL'",
                  "semaphore": true
                }
              ],
              "default": "HAL"
            },
            "init_type": {
              "type": "string",
              "title": "Resource initialization code generation",
              "description": "Pick whether the initialization code should be generated and automatically called at startup.",
              "oneOf": [
                {
                  "title": "Callable",
                  "const": "called",
                  "description": "Initialization code is generated and called in peripheral initialization."
                },
                {
                  "title": "Generated",
                  "const": "enabled",
                  "description": "Initialization code is generated but not called in peripheral initialization."
                },
                {
                  "title": "Not generated",
                  "const": "disabled",
                  "description": "Initialization code is not generated."
                }
              ],
              "default": "called"
            }
          }
        },
        "basic": {
          "type": "object",
          "title": "Main features",
          "properties": {
            "rng_standard": {
              "type": "integer",
              "title": "RNG standard",
              "oneOf": [
                {
                  "const": 0,
                  "title": "Certified NIST",
                  "actions": [
                    {
                  "type": "exclude",
                  "condition": "true"
                    }
                  ]
                },
                {
                  "const": 1,
                  "title": "Candidate NIST"
                },
                {
                  "const": 2,
                  "title": "German BSI"
                },
                {
                  "const": 3,
                  "title": "Custom"
                }
              ],
              "default": 1
            },
            "config_1": {
              "type": "integer",
              "title": "Value 1",
              "description": "Value1 must be a value between 0 and 0x3F.",
              "actions": [
                {
                  "type": "include",
                  "condition": "$basic.rng_standard==3"
                }
              ],
              "display_format": [
                "hex"
              ],
              "maximum": 63,
              "minimum": 0,
              "default": 8
            },
            "config_2": {
              "type": "integer",
              "title": "Value 2",
              "description": "Value2 must be a value between 0 and 0x7.",
              "actions": [
                {
                  "type": "include",
                  "condition": "$basic.rng_standard==3"
                }
              ],
              "display_format": [
                "hex"
              ],
              "maximum": 7,
              "default": 0
            },
            "config_3": {
              "type": "integer",
              "title": "Value 3",
              "description": "Value3 must be a value between 0 and 0xF.",
              "actions": [
                {
                  "type": "include",
                  "condition": "$basic.rng_standard==3"
                }
              ],
              "display_format": [
                "hex"
              ],
              "maximum": 15,
              "minimum": 0,
              "default": 13
            },
            "health_test": {
              "type": "integer",
              "title": "Health test",
              "description": "RNG health test.",
              "actions": [
                {
                  "type": "include",
                  "condition": "$basic.rng_standard==3"
                }
              ],
              "maximum": 4294967295,
              "minimum": 0,
              "default": 29356
            },
            "clock_divider": {
              "type": "integer",
              "title": "Clock divider",
              "description": "Number of clock cycles per internal clock.",
              "default": 1,
              "actions": [
                {
                  "type": "include",
                  "condition": "$basic.rng_standard==3"
                }
              ],
              "oneOf": [
                {
                  "title": "1 clock cycle",
                  "const": 1
                },
                {
                  "title": "2 clock cycles",
                  "const": 2
                },
                {
                  "title": "4 clock cycles",
                  "const": 4
                },
                {
                  "title": "8 clock cycles",
                  "const": 8
                },
                {
                  "title": "16 clock cycles",
                  "const": 16
                },
                {
                  "title": "32 clock cycles",
                  "const": 32
                },
                {
                  "title": "64 clock cycles",
                  "const": 64
                },
                {
                  "title": "128 clock cycles",
                  "const": 128
                },
                {
                  "title": "256 clock cycles",
                  "const": 256
                },
                {
                  "title": "512 clock cycles",
                  "const": 512
                },
                {
                  "title": "1024 clock cycles",
                  "const": 1024
                },
                {
                  "title": "2048 clock cycles",
                  "const": 2048
                },
                {
                  "title": "4096 clock cycles",
                  "const": 4096
                },
                {
                  "title": "8192 clock cycles",
                  "const": 8192
                },
                {
                  "title": "16384 clock cycles",
                  "const": 16384
                },
                {
                  "title": "32768 clock cycles",
                  "const": 32768
                }
              ]
            },
            "standard": {
              "type": "string",
              "title": "Standard",
              "description": "RNG NIST compliance.",
              "default": "CUSTOM",
              "actions": [
                {
                  "type": "include",
                  "condition": "$basic.rng_standard==3"
                }
              ],
              "oneOf": [
                {
                  "title": "RNG custom",
                  "const": "CUSTOM"
                },
                {
                  "title": "RNG NIST compliant",
                  "const": "NIST"
                }
              ]
            },
            "clock_error_detection": {
              "type": "boolean",
              "default": true,
              "title": "RNG clock error detection state",
              "actions": [
                {
                  "type": "include",
                  "condition": "$basic.rng_standard==3"
                }
              ]
            },
            "noise_source": {
              "type": "object",
              "title": "Noise source",
              "description": "RNG noise source structure definition.",
              "actions": [
                {
                  "type": "include",
                  "condition": "$basic.rng_standard==3"
                }
              ],
              "properties": {
                "osc_1_src": {
                  "type": "object",
                  "title": "Oscillator noise source 1",
                  "description": "This parameter represent the selection of one or a combination of oscillator noise sources.",
                  "objectType": "polynomial",
                  "size": [
                    3
                  ],
                  "default": {
                    "value": 7,
                    "size": 3
                  }
                },
                "osc_2_src": {
                  "type": "object",
                  "title": "Oscillator noise source 2",
                  "description": "This parameter represent the selection of one or a combination of oscillator noise sources.",
                  "objectType": "polynomial",
                  "size": [
                    3
                  ],
                  "default": {
                    "value": 7,
                    "size": 3
                  }
                },
                "osc_3_src": {
                  "type": "object",
                  "title": "Oscillator noise source 3",
                  "description": "This parameter represent the selection of one or a combination of oscillator noise sources.",
                  "objectType": "polynomial",
                  "size": [
                    3
                  ],
                  "default": {
                    "value": 7,
                    "size": 3
                  }
                },
                "osc_4_src": {
                  "type": "object",
                  "title": "Oscillator noise source 4",
                  "description": "This parameter represent the selection of one or a combination of oscillator noise sources.",
                  "objectType": "polynomial",
                  "size": [
                    3
                  ],
                  "default": {
                    "value": 7,
                    "size": 3
                  }
                },
                "osc_5_src": {
                  "type": "object",
                  "title": "Oscillator noise source 5",
                  "description": "This parameter represent the selection of one or a combination of oscillator noise sources.",
                  "objectType": "polynomial",
                  "size": [
                    3
                  ],
                  "default": {
                    "value": 7,
                    "size": 3
                  }
                },
                "osc_6_src": {
                  "type": "object",
                  "title": "Oscillator noise source 6",
                  "description": "This parameter represent the selection of one or a combination of oscillator noise sources.",
                  "objectType": "polynomial",
                  "size": [
                    3
                  ],
                  "default": {
                    "value": 7,
                    "size": 3
                  }
                }
              }
            },
            "rng_cert_nist_cr": {
              "type": "integer",
              "title": "Certified NIST ",
              "default": 15731968,
              "actions": [
                {
                  "type": "include",
                  "condition": "$basic.rng_standard==0"
                },
                {
                  "type": "set",
                  "condition": "$basic.rng_standard==0",
                  "attributes": {
                    "const": 15731968
                  }
                },
                {
                  "type": "disable",
                  "condition": "true"
                }
              ],
              "display_format": [
                "hex"
              ]
            },
            "rng_cert_nist_nscr": {
              "type": "integer",
              "title": "Certified NIST noise source",
              "default": 97467,
              "actions": [
                {
                  "type": "include",
                  "condition": "$basic.rng_standard==0"
                },
                {
                  "type": "set",
                  "condition": "$basic.rng_standard==0",
                  "attributes": {
                    "const": 97467
                  }
                },
                {
                  "type": "disable",
                  "condition": "true"
                }
              ],
              "display_format": [
                "hex"
              ]
            },
            "rng_cert_nist_htcr": {
              "type": "integer",
              "title": "Certified NIST health test",
              "default": 41648,
              "actions": [
                {
                  "type": "include",
                  "condition": "$basic.rng_standard==0"
                },
                {
                  "type": "set",
                  "condition": "$basic.rng_standard==0",
                  "attributes": {
                    "const": 41648
                  }
                },
                {
                  "type": "disable",
                  "condition": "true"
                }
              ],
              "display_format": [
                "hex"
              ]
            },
            "rng_cand_nist_cr": {
              "type": "integer",
              "title": "Candidate NIST",
              "default":1048832,
              "actions": [
                {
                  "type": "include",
                  "condition": "$basic.rng_standard==1"
                },
                {
                  "type": "set",
                  "condition": "$basic.rng_standard==1",
                  "attributes": {
                    "const":1048832
                  }
                },
                {
                  "type": "disable",
                  "condition": "true"
                }
              ],
              "display_format": [
                "hex"
              ]
            },
            "rng_cand_nist_nscr": {
              "type": "integer",
              "title": "Candidate NIST noise source",
              "default":511,
              "actions": [
                {
                  "type": "include",
                  "condition": "$basic.rng_standard==1"
                },
                {
                  "type": "set",
                  "condition": "$basic.rng_standard==1",
                  "attributes": {
                    "const":511
                  }
                },
                {
                  "type": "disable",
                  "condition": "true"
                }
              ],
              "display_format": [
                "hex"
              ]
            },
            "rng_cand_nist_htcr": {
              "type": "integer",
              "title": "Candidate NIST health test",
              "default":43719,
              "actions": [
                {
                  "type": "include",
                  "condition": "$basic.rng_standard==1"
                },
                {
                  "type": "set",
                  "condition": "$basic.rng_standard==1",
                  "attributes": {
                    "const":43719
                  }
                },
                {
                  "type": "disable",
                  "condition": "true"
                }
              ],
              "display_format": [
                "hex"
              ]
            },
            "rng_cand_german_bsi_cr": {
              "type": "integer",
              "title": "Candidate german BSI",
              "default":136318720,
              "actions": [
                {
                  "type": "include",
                  "condition": "$basic.rng_standard==2"
                },
                {
                  "type": "set",
                  "condition": "$basic.rng_standard==2",
                  "attributes": {
                    "const":136318720
                  }
                },
                {
                  "type": "disable",
                  "condition": "true"
                }
              ],
              "display_format": [
                "hex"
              ]
            },
            "rng_cand_german_bsi_nscr": {
              "type": "integer",
              "title": "Candidate german BSI noise source",
              "default":511,
              "actions": [
                {
                  "type": "include",
                  "condition": "$basic.rng_standard==2"
                },
                {
                  "type": "set",
                  "condition": "$basic.rng_standard==2",
                  "attributes": {
                    "const":511
                  }
                },
                {
                  "type": "disable",
                  "condition": "true"
                }
              ],
              "display_format": [
                "hex"
              ]
            },
            "rng_cand_german_bsi_htcr": {
              "type": "integer",
              "title": "Candidate german BSI health test",
              "default":43719,
              "actions": [
                {
                  "type": "include",
                  "condition": "$basic.rng_standard==2"
                },
                {
                  "type": "set",
                  "condition": "$basic.rng_standard==2",
                  "attributes": {
                    "const":43719
                  }
                },
                {
                  "type": "disable",
                  "condition": "true"
                }
              ],
              "display_format": [
                "hex"
              ]
            }
          }
        },
        "additional": {
          "type": "object",
          "description": "All Functions.",
          "title": "Advanced features",
          "properties": {
            "enable_clock_error_detection": {
              "type": "boolean",
              "title": "Clock error detection",
              "default": false
            },
            "enable_auto_reset": {
              "type": "boolean",
              "title": "Automatic reset",
              "default": false
            }
          }
        },
        "system": {
          "type": "object",
          "title": "System",
          "description": "RNG Global Structure definition.",
          "properties": {
            "nvic": {
              "title": "NVIC",
              "type": "object",
              "properties": {
                "enable_interruption": {
                  "type": "boolean",
                  "default": false,
                  "title": "Interruption"
                },
                "irq_handler_generation": {
                  "title": "IRQ handler generation",
                  "type": "boolean",
                  "default": true,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.nvic.enable_interruption && $info.layer === 'HAL'"
                    }
                  ]
                },
                "irq_config": {
                  "title": "IRQ line priority",
                  "type": "object",
                  "objectType": "need.interrupt.lines",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_CORTEX_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "*"
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.nvic.enable_interruption"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}