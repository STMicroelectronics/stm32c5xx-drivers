{
  "$schema": "http://json-schema.org/draft-07/schema",
  "version": "0.0.1",
  "componentid": "::Device:STM32CubeMX2 Config:CORTEX NVIC",
  "grammarVersion": "3.8",
  "type": "object",
  "properties": {
    "parameters": {
      "type": "object",
      "properties": {
        "info": {
          "title": "General information",
          "type": "object",
          "properties": {
            "labels": {
              "type": "array",
              "title": "Add a label",
              "description": "Labels allow to create aliases inside mx_hal_def.h file like '<label>_init', '<label>_deinit' and '<label>_gethandle'. These aliases can be used on application side.",
              "items": {
                "type": "string",
                "minLength": 0,
                "maxLength": 32,
                "unique": "project",
                "default": "",
                "actions": [
                  {
                    "type": "error",
                    "condition": "!/^[A-Za-z_][A-Za-z0-9_]*$/.test($value)",
                    "message": "Name must be a valid C identifier: start with a letter or underscore, and contain only letters, digits, or underscores."
                  }
                ]
              }
            },
            "layer": {
              "title": "Software layer",
              "type": "string",
              "oneOf": [
                {
                  "title": "HAL",
                  "const": "HAL"
                },
                {
                  "title": "ARM CMSIS",
                  "const": "LL"
                }
              ],
              "default": "HAL",
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_CORTEX_PROJECT_USE_HAL",
                  "condition": "$value === 'HAL'",
                  "semaphore": true
                }
              ]
            },
            "init_type": {
              "title": "Resource initialization code generation",
              "type": "string",
              "description": "Pick whether the initialization code should be generated and automatically called at startup.",
              "oneOf": [
                {
                  "title": "Callable",
                  "const": "called",
                  "description": "Initialization code is generated and called in peripheral initialization."
                },
                {
                  "title": "Generated",
                  "const": "enabled",
                  "description": "Initialization code is generated but not called in peripheral initialization."
                },
                {
                  "title": "Not generated",
                  "const": "disabled",
                  "description": "Initialization code is not generated."
                }
              ],
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_CORTEX_CORE_ENABLED",
                  "value": true
                }
              ],
              "default": "called"
            }
          }
        },
        "system": {
          "title": "System",
          "type": "object",
          "properties": {
            "nvic": {
              "title": "NVIC",
              "type": "object",
              "properties": {
                "enable_management_svc": {
                  "title": "SVC management",
                  "type": "boolean",
                  "default": true,
                  "description": "Supervisor call (SVC) exception is always enabled, you may disable its management to remove related code generation.",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "(!$get('swproject.hasRTOSenabled'))"
                    }
                  ]
                },
                "irq_config1": {
                  "title": "SVC priority",
                  "type": "object",
                  "objectType": "need.interrupt.lines",
                  "owner": "$resource.name",
                  "needs": [
                    {
                      "selector": "system:SVC"
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "(!$get('swproject.hasRTOSenabled')) && $system.nvic.enable_management_svc"
                    }
                  ]
                },
                "enable_management_pendsv": {
                  "title": "Pendable service management",
                  "type": "boolean",
                  "default": true,
                  "description": "PendSV exception is always enabled, you may disable its management to remove related code generation.",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "(!$get('swproject.hasRTOSenabled'))"
                    }
                  ]
                },
                "irq_config2": {
                  "title": "Pendable service priority",
                  "type": "object",
                  "objectType": "need.interrupt.lines",
                  "owner": "$resource.name",
                  "needs": [
                    {
                      "selector": "system:PendSV"
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "(!$get('swproject.hasRTOSenabled')) && $system.nvic.enable_management_pendsv"
                    }
                  ]
                },
                "enable_exception_debugmon": {
                  "title": "Debug monitor exception and management",
                  "type": "boolean",
                  "default": true
                },
                "irq_config3": {
                  "title": "Debug monitor priority",
                  "type": "object",
                  "objectType": "need.interrupt.lines",
                  "owner": "$resource.name",
                  "needs": [
                    {
                      "selector": "system:DebugMonitor"
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.nvic.enable_exception_debugmon"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}