{
  "$schema": "http://json-schema.org/draft-07/schema",
  "version": "0.0.1",
  "componentid": "::Device:STM32 MX Config:COMP",
  "grammarVersion": "3.31",
  "type": "object",
  "functions": [
    {
      "path": ".config/template/helpers/comp_helpers.js",
      "accessor": "common"
    },
    {
      "path": ".config/template/helpers/common_helpers.js",
      "accessor": "com"
    }
  ],
  "properties": {
    "parameters": {
      "type": "object",
      "properties": {
        "info": {
          "type": "object",
          "title": "General information",
          "properties": {
            "labels": {
              "type": "array",
              "title": "Add a label",
              "description": "Labels allow to create aliases inside mx_hal_def.h file like '<label>_init', '<label>_deinit' and '<label>_gethandle'. These aliases can be used on application side.",
              "items": {
                "type": "string",
                "actions": [
                  {
                    "type": "error",
                    "condition": "!/^[A-Za-z_][A-Za-z0-9_]*$/.test($value)",
                    "message": "Name must be a valid C identifier: start with a letter or underscore, and contain only letters, digits, or underscores."
                  }
                ],
                "minLength": 0,
                "maxLength": 32,
                "unique": "project",
                "default": ""
              }
            },
            "layer": {
              "type": "string",
              "title": "Software layer",
              "oneOf": [
                {
                  "title": "HAL",
                  "const": "HAL"
                },
                {
                  "title": "LL",
                  "const": "LL"
                }
              ],
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_COMP_PROJECT_USE_HAL",
                  "condition": "$value === 'HAL'",
                  "semaphore": true
                }
              ],
              "default": "HAL"
            },
            "init_type": {
              "type": "string",
              "title": "Resource initialization code generation",
              "description": "Pick whether the initialization code should be generated and automatically called at startup.",
              "oneOf": [
                {
                  "title": "Callable",
                  "const": "called",
                  "description": "Initialization code is generated and called in peripheral initialization."
                },
                {
                  "title": "Generated",
                  "const": "enabled",
                  "description": "Initialization code is generated but not called in peripheral initialization."
                },
                {
                  "title": "Not generated",
                  "const": "disabled",
                  "description": "Initialization code is not generated."
                }
              ],
              "default": "called"
            }
          }
        },
        "basic": {
          "type": "object",
          "title": "Main features",
          "properties": {
            "comp_mode_1_2": {
              "title": "Windows mode COMP1/2",
              "description": "Ability to combine 2 comparator instances for common operation (COMP1 and COMP2, COMP3 and COMP4, ...).",
              "type": "string",
              "oneOf": [
                {
                  "title": "Independent",
                  "description": "Comparator instance independent (versus other comparator instances). Default mode.",
                  "const": "mode_independent"
                },
                {
                  "title": "Window",
                  "description": "Combine multiple COMP instances for voltage comparison to 2 thresholds.",
                  "const": "mode_window",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "true"
                    }
                  ]
                }
              ],
              "default": "mode_independent",
              "synchronize": true,
              "actions": [
                {
                  "type": "include",
                  "condition": "false && (($resource.name == 'COMP1') || ($resource.name == 'COMP2'))"
                }
              ]
            },
            "comp_mode_3_4": {
              "title": "Windows mode COMP3/4",
              "description": "Ability to combine 2 comparator instances for common operation (COMP1 and COMP2, COMP3 and COMP4, ...).",
              "type": "string",
              "oneOf": [
                {
                  "title": "Independent",
                  "description": "Comparator instance independent (versus other comparator instances). Default mode.",
                  "const": "mode_independent"
                },
                {
                  "title": "Window",
                  "description": "Combine multiple COMP instances for voltage comparison to 2 thresholds.",
                  "const": "mode_window",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "true"
                    }
                  ]
                }
              ],
              "default": "mode_independent",
              "synchronize": true,
              "actions": [
                {
                  "type": "include",
                  "condition": "($resource.name == 'COMP3') || ($resource.name == 'COMP4')"
                },
                {
                  "type": "disable",
                  "condition": "($resource.name == 'COMP4')"
                }
              ]
            },
            "comp_mode_5_6": {
              "title": "Windows mode COMP5/6",
              "description": "Ability to combine 2 comparator instances for common operation (COMP1 and COMP2, COMP3 and COMP4, ...).",
              "type": "string",
              "oneOf": [
                {
                  "title": "Independent",
                  "description": "Comparator instance independent (versus other comparator instances). Default mode.",
                  "const": "mode_independent"
                },
                {
                  "title": "Window",
                  "description": "Combine multiple COMP instances for voltage comparison to 2 thresholds.",
                  "const": "mode_window",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "true"
                    }
                  ]
                }
              ],
              "default": "mode_independent",
              "synchronize": true,
              "actions": [
                {
                  "type": "include",
                  "condition": "($resource.name == 'COMP5') || ($resource.name == 'COMP6')"
                }
              ]
            },
            "comp_mode_7_8": {
              "title": "Windows mode COMP7/8",
              "description": "Ability to combine 2 comparator instances for common operation (COMP1 and COMP2, COMP3 and COMP4, ...).",
              "type": "string",
              "oneOf": [
                {
                  "title": "Independent",
                  "description": "Comparator instance independent (versus other comparator instances). Default mode.",
                  "const": "mode_independent"
                },
                {
                  "title": "Window",
                  "description": "Combine multiple COMP instances for voltage comparison to 2 thresholds.",
                  "const": "mode_window",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "true"
                    }
                  ]
                }
              ],
              "default": "mode_independent",
              "synchronize": true,
              "actions": [
                {
                  "type": "include",
                  "condition": "($resource.name == 'COMP7') || ($resource.name == 'COMP8')"
                }
              ]
            },
            "comp_mode": {
              "title": "Mode status",
              "description": "Ability to combine 2 comparator instances for common operation (COMP1 and COMP2, COMP3 and COMP4, ...).",
              "type": "string",
              "default": "mode_independent",
              "actions": [
                {
                  "type": "set",
                  "computed": {
                    "const": "($basic.comp_mode_1_2 ? $basic.comp_mode_1_2 : ($basic.comp_mode_3_4 ? $basic.comp_mode_3_4 : ($basic.comp_mode_5_6 ? $basic.comp_mode_5_6 : ($basic.comp_mode_7_8 ? $basic.comp_mode_7_8 : 'error_window_inst')))).replace('x_', '')"
                  }
                },
                {
                  "type": "disable",
                  "condition": "true"
                },
                {
                  "type": "exclude",
                  "condition": "true"
                }
              ]
            },
            "comp_mode_window_control_inst_main": {
              "title": "Window controlling comparator instance",
              "type": "string",
              "default": "COMPx",
              "actions": [
                {
                  "type": "set",
                  "computed": {
                    "const": "'COMP' + $common.helper_comp_get_window_other_instance_nb($resource.name)"
                  }
                },
                {
                  "type": "disable",
                  "condition": "true"
                },
                {
                  "type": "include",
                  "condition": "($common.helper_comp_is_window_instance_main($resource.name) == true) && ($comp_mode == 'mode_window')"
                }
              ]
            },
            "comp_mode_window_control_inst_sec": {
              "title": "Window controlled by comparator instance",
              "type": "string",
              "default": "COMPx",
              "actions": [
                {
                  "type": "set",
                  "computed": {
                    "const": "'COMP' + $common.helper_comp_get_window_other_instance_nb($resource.name)"
                  }
                },
                {
                  "type": "disable",
                  "condition": "true"
                },
                {
                  "type": "include",
                  "condition": "($common.helper_comp_is_window_instance_main($resource.name) != true) && ($comp_mode == 'mode_window')"
                }
              ]
            },
            "power_mode": {
              "type": "string",
              "description": "Select tradeoff between comparator speed and power consumption.",
              "default": "HIGH_SPEED",
              "oneOf": [
                {
                  "title": "High speed",
                  "const": "HIGH_SPEED"
                },
                {
                  "title": "Medium speed",
                  "const": "MEDIUM_SPEED"
                },
                {
                  "title": "Ultra-low power",
                  "const": "ULTRA_LOW_POWER"
                }
              ],
              "title": "Power mode"
            },
            "input": {
              "title": "Input",
              "type": "object",
              "properties": {
                "input_plus": {
                  "description": "Select the positive input for the COMP.",
                  "title": "Plus",
                  "type": "object",
                  "objectType": "query",
                  "query": {
                    "parent": "$resource.name",
                    "title": "{{source.replace(/COMP\\d+_INP(\\w+)/g, 'IO$1').replace('DAC1_INT', 'DAC1 channel 1').replace('DAC2_INT', 'DAC1 channel 2').replace(/opamp(\\d+)_int/g, 'OPAMP$1 output')}}",
                    "entity": [
                      "peripheral.interconnect.analog input plus",
                      "peripheralBlock.interconnect.analog input plus"
                    ],
                    "where": "($entity.source != 'VSSA') && ($entity.source != 'GND') && (!($entity.source.startsWith('COMP')) || ($get('pinout.peripheralCanBeMapped', $resource.name, $entity.source.replace(/COMP\\d+_INP(\\w+)/g, 'INP$1')) == true))",
                    "sharing": false
                  },
                  "select": "first",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "true"
                    }
                  ]
                },
                "input_minus": {
                  "description": "Select the negative input for the COMP.",
                  "title": "Minus",
                  "type": "object",
                  "objectType": "query",
                  "query": {
                    "parent": "$resource.name",
                    "title": "{{source.replace(/COMP\\d+_INM(\\w+)/g, 'IO$1').replace('VBG', 'VrefInt').replace(/DAC(\\d+)_INT/g, 'DAC1 channel $1').replace(/dac(\\d+)_out(\\d+)/g, 'DAC$1 channel $2').replace('VSENS', 'Temperature sensor')}}",
                    "entity": [
                      "peripheral.interconnect.analog input minus",
                      "peripheralBlock.interconnect.analog input minus"
                    ],
                    "where": "($entity.source != 'VSSA') && ($entity.source != 'GND') && (!($entity.source.startsWith('COMP')) || ($get('pinout.peripheralCanBeMapped', $resource.name, $entity.source.replace(/COMP\\d+_INM(\\w+)/g, 'INM$1')) == true))",
                    "sharing": false
                  },
                  "select": "first",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "($basic.comp_mode_1_2 === 'mode_window') || ($basic.comp_mode_3_4 === 'mode_window') || ($basic.comp_mode_5_6 === 'mode_window') || ($basic.comp_mode_7_8 === 'mode_window')"
                    }
                  ]
                },
                "window_upper_threshold": {
                  "description": "Select the upper threshold for the comparator window mode.",
                  "title": "Window upper threshold",
                  "type": "object",
                  "objectType": "query",
                  "query": {
                    "parent": "$resource.name",
                    "title": "{{source.replace(/COMP\\d+_INM(\\w+)/g, 'IO$1').replace('VBG', 'VrefInt').replace(/DAC(\\d+)_INT/g, 'DAC1 channel $1').replace(/dac(\\d+)_out(\\d+)/g, 'DAC$1 channel $2').replace('VSENS', 'Temperature sensor')}}",
                    "entity": [
                      "peripheral.interconnect.analog input minus",
                      "peripheralBlock.interconnect.analog input minus"
                    ],
                    "where": "($entity.source != 'VSSA') && ($entity.source != 'GND') && (!($entity.source.startsWith('COMP')) || ($get('pinout.peripheralCanBeMapped', $resource.name, $entity.source.replace(/COMP\\d+_INM(\\w+)/g, 'INM$1')) == true))",
                    "sharing": false
                  },
                  "select": "first",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "($basic.comp_mode_1_2 === 'mode_window') || ($basic.comp_mode_3_4 === 'mode_window') || ($basic.comp_mode_5_6 === 'mode_window') || ($basic.comp_mode_7_8 === 'mode_window')"
                    }
                  ]
                },
                "window_lower_threshold": {
                  "description": "Select the lower threshold for the comparator window mode.",
                  "title": "Window lower threshold",
                  "type": "object",
                  "objectType": "query",
                  "query": {
                    "parent": "$resource.name",
                    "title": "{{source.replace(/COMP\\d+_INM(\\w+)/g, 'IO$1').replace('VBG', 'VrefInt').replace(/DAC(\\d+)_INT/g, 'DAC1 channel $1').replace(/dac(\\d+)_out(\\d+)/g, 'DAC$1 channel $2').replace('VSENS', 'Temperature sensor')}}",
                    "entity": [
                      "peripheral.interconnect.analog input minus",
                      "peripheralBlock.interconnect.analog input minus"
                    ],
                    "where": "($entity.source != 'VSSA') && ($entity.source != 'GND') && (!($entity.source.startsWith('COMP')) || ($get('pinout.peripheralCanBeMapped', $resource.name, $entity.source.replace(/COMP\\d+_INM(\\w+)/g, 'INM$1')) == true))",
                    "sharing": false
                  },
                  "select": "first",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "($basic.comp_mode_1_2 === 'mode_window') || ($basic.comp_mode_3_4 === 'mode_window') || ($basic.comp_mode_5_6 === 'mode_window') || ($basic.comp_mode_7_8 === 'mode_window')"
                    }
                  ]
                },
                "input_hysteresis": {
                  "type": "string",
                  "description": "Set hysteresis applied to input plus, subtracted to input voltage value.",
                  "default": "NONE",
                  "oneOf": [
                    {
                      "title": "None",
                      "const": "NONE"
                    },
                    {
                      "title": "Low",
                      "const": "LOW"
                    },
                    {
                      "title": "Medium",
                      "const": "MEDIUM"
                    },
                    {
                      "title": "High",
                      "const": "HIGH"
                    }
                  ],
                  "title": "Hysteresis"
                }
              }
            },
            "output": {
              "title": "Output",
              "type": "object",
              "properties": {
                "output_polarity": {
                  "type": "string",
                  "description": "Select output logical level corresponding to input analog comparison state.",
                  "default": "NONINVERTED",
                  "oneOf": [
                    {
                      "title": "Not inverted",
                      "const": "NONINVERTED"
                    },
                    {
                      "title": "Inverted",
                      "const": "INVERTED"
                    }
                  ],
                  "title": "Polarity"
                },
                "output_trigger": {
                  "type": "string",
                  "description": "Select COMP output trigger to system (wake up from system low power mode, CPU event, interrupt).",
                  "oneOf": [
                    {
                      "title": "None",
                      "const": "NONE"
                    },
                    {
                      "title": "Through EXTI",
                      "const": "EXTI",
                      "description": "Refer to EXTI panel for trigger configuration (edge detection, interrupt)."
                    }
                  ],
                  "title": "Trigger to system",
                  "default": "NONE",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "COMP_USE_HAL_COMP_EXTI",
                      "computed_value": "($basic.output.output_trigger == 'EXTI') && ($info.layer === 'HAL')",
                      "semaphore": true
                    }
                  ]
                },
                "window_output_mode": {
                  "type": "string",
                  "description": "Window comparators output combination.",
                  "oneOf": [
                    {
                      "title": "Independent",
                      "const": "INDEPT",
                      "description": "Comparators window output default mode: both comparators output are independent, indicating each their own state.\nNote: To know signal state versus window thresholds, read each comparator output and perform a logical \"exclusive or\" operation."
                    },
                    {
                      "title": "XOR",
                      "const": "XOR",
                      "description": "Comparators window output synthesized on a single comparator output: comparator no more indicating its own state, but window state (XOR: logical \"exclusive or\"). Logical high means monitored signal is within comparators window thresholds. Comparator instance selected corresponds to handle assigned as upper threshold in @ref HAL_COMP_WINDOW_SetHandle().\nNote: impacts only comparator output signal level (propagated to GPIO, EXTI lines, timers, ...), does not impact output digital state (hal_comp_output_level_t) always reflecting each comparator output state. */."
                    }
                  ],
                  "title": "Window output mode",
                  "default": "INDEPT",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$comp_mode === 'mode_window'"
                    }
                  ]
                }
              }
            }
          },
          "actions": [
            {
              "type": "disable",
              "condition": "($common.helper_comp_is_window_instance_main($resource.name) != true) && ($comp_mode == 'mode_window')"
            }
          ]
        },
        "additional": {
          "type": "object",
          "description": "Enable output blanking to temporarily suppress the COMP output during specific events.",
          "title": "Advanced features",
          "properties": {
            "output_blanking_state": {
              "title": "Output blanking",
              "type": "boolean",
              "default": false
            },
            "output_blanking_src": {
              "description": "Select the internal signal that triggers output blanking.",
              "title": "Output blanking source",
              "type": "object",
              "objectType": "query",
              "query": {
                "parent": "$resource.name",
                "title": "{{source.toUpperCase()}}",
                "entity": [
                  "peripheral.interconnect.internal input trigger",
                  "peripheralBlock.interconnect.internal input trigger"
                ],
                "sharing": false
              },
              "select": "first",
              "actions": [
                {
                  "type": "include",
                  "condition": "$additional.output_blanking_state"
                }
              ]
            }
          },
          "actions": [
            {
              "type": "disable",
              "condition": "($common.helper_comp_is_window_instance_main($resource.name) != true) && ($comp_mode == 'mode_window')"
            }
          ]
        },
        "system": {
          "type": "object",
          "title": "System",
          "properties": {
            "gpio": {
              "type": "object",
              "title": "GPIO",
              "properties": {
                "comp_input_plus_gpio_inp1": {
                  "title": "GPIO for comparator input plus",
                  "type": "object",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.name",
                  "needs": [
                    {
                      "selector": "INP1",
                      "constraints": {
                        "mode": {
                          "const": "ANALOG"
                        },
                        "pull": {
                          "const": "NO"
                        }
                      }
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "(($basic.input.input_plus.source.includes('INP1')) && $get('pinout.peripheralCanBeMapped', $resource.name, 'INP1')) == true"
                    }
                  ]
                },
                "comp_input_plus_gpio_inp2": {
                  "title": "GPIO for comparator input plus",
                  "type": "object",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.name",
                  "needs": [
                    {
                      "selector": "INP2",
                      "constraints": {
                        "mode": {
                          "const": "ANALOG"
                        },
                        "pull": {
                          "const": "NO"
                        }
                      }
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "(($basic.input.input_plus.source.includes('INP2')) && $get('pinout.peripheralCanBeMapped', $resource.name, 'INP2')) == true"
                    }
                  ]
                },
                "comp_input_plus_gpio_inp3": {
                  "title": "GPIO for comparator input plus",
                  "type": "object",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.name",
                  "needs": [
                    {
                      "selector": "INP3",
                      "constraints": {
                        "mode": {
                          "const": "ANALOG"
                        },
                        "pull": {
                          "const": "NO"
                        }
                      }
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "(($basic.input.input_plus.source.includes('INP3')) && $get('pinout.peripheralCanBeMapped', $resource.name, 'INP3')) == true"
                    }
                  ]
                },
                "comp_input_minus_gpio_inm1": {
                  "title": "GPIO for comparator input minus",
                  "type": "object",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.name",
                  "needs": [
                    {
                      "selector": "INM1",
                      "constraints": {
                        "mode": {
                          "const": "ANALOG"
                        },
                        "pull": {
                          "const": "NO"
                        }
                      }
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "((($basic.input.input_minus?.source.includes('INM1')) || ($basic.input.window_upper_threshold?.source.includes('INM1')) || ($basic.input.window_lower_threshold.source?.includes('INM1'))) && $get('pinout.peripheralCanBeMapped', $resource.name, 'INM1')) == true"
                    }
                  ]
                },
                "comp_input_minus_gpio_inm2": {
                  "title": "GPIO for comparator input minus",
                  "type": "object",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.name",
                  "needs": [
                    {
                      "selector": "INM2",
                      "constraints": {
                        "mode": {
                          "const": "ANALOG"
                        },
                        "pull": {
                          "const": "NO"
                        }
                      }
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "((($basic.input.input_minus?.source.includes('INM2')) || ($basic.input.window_upper_threshold?.source.includes('INM2')) || ($basic.input.window_lower_threshold.source?.includes('INM2'))) && $get('pinout.peripheralCanBeMapped', $resource.name, 'INM2')) == true"
                    }
                  ]
                },
                "comp_input_minus_gpio_inm3": {
                  "title": "GPIO for comparator input minus",
                  "type": "object",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.name",
                  "needs": [
                    {
                      "selector": "INM3",
                      "constraints": {
                        "mode": {
                          "const": "ANALOG"
                        },
                        "pull": {
                          "const": "NO"
                        }
                      }
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "((($basic.input.input_minus?.source.includes('INM3')) || ($basic.input.window_upper_threshold?.source.includes('INM3')) || ($basic.input.window_lower_threshold.source?.includes('INM3'))) && $get('pinout.peripheralCanBeMapped', $resource.name, 'INM3')) == true"
                    }
                  ]
                },
                "comp_output_gpio_status": {
                  "title": "Comparator output to GPIO",
                  "description": "Output connection to GPIO (digital mode), optional.",
                  "type": "boolean",
                  "default": false
                },
                "comp_output_gpio": {
                  "title": "GPIO for comparator output",
                  "type": "object",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.name",
                  "needs": [
                    {
                      "selector": "OUT",
                      "constraints": {
                        "mode": {
                          "const": "ALTERNATE"
                        }
                      }
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.gpio.comp_output_gpio_status === true"
                    }
                  ]
                }
              }
            },
            "exti": {
              "title": "EXTI line",
              "description": "Comparator uses EXTI line for system wake up from system low power mode, CPU event and interrupt.",
              "type": "object",
              "objectType": "need.exti.lines",
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_EXTI_PROJECT_USE_HAL",
                  "condition": "$info.layer === 'HAL'",
                  "semaphore": true
                }
              ],
              "owner": "$resource.name",
              "needs": [
                {
                  "selector": "*",
                  "constraints": {
                    "trigger_detection": {
                      "default": "RISING_FALLING"
                    },
                    "enable_interruption": {
                      "default": true
                    }
                  }
                }
              ],
              "actions": [
                {
                  "type": "exclude",
                  "condition": "$basic.output.output_trigger != 'EXTI'"
                }
              ]
            }
          }
        }
      }
    }
  }
}