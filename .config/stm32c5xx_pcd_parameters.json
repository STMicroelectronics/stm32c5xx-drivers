{
  "$schema": "http://json-schema.org/draft-07/schema",
  "version": "0.0.1",
  "componentid": "::Device:STM32CubeMX2 Config:PCD",
  "grammarVersion": "3.1",
  "type": "object",
  "functions": [
    {
      "path": ".config/template/helpers/usb_helpers.js",
      "accessor": "common"
    },
    {
      "path": ".config/template/helpers/common_helpers.js",
      "accessor": "com"
    }
  ],
  "properties": {
    "parameters": {
      "type": "object",
      "properties": {
        "info": {
          "type": "object",
          "title": "General information",
          "properties": {
            "labels": {
              "type": "array",
              "title": "Add a label",
              "description": "Labels allow to create aliases inside mx_hal_def.h file like '<label>_init', '<label>_deinit' and '<label>_gethandle'. These aliases can be used on application side.",
              "items": {
                "type": "string",
                "actions": [
                  {
                    "type": "error",
                    "condition": "!/^[A-Za-z_][A-Za-z0-9_]*$/.test($value)",
                    "message": "Name must be a valid C identifier: start with a letter or underscore, and contain only letters, digits, or underscores."
                  }
                ],
                "minLength": 0,
                "maxLength": 32,
                "unique": "project",
                "default": ""
              }
            },
            "layer": {
              "type": "string",
              "title": "Software layer",
              "default": "HAL",
              "actions": [
                {
                  "type": "disable",
                  "condition": "$com.helper_common_display_object($resource)"
                }
              ],
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_PCD_PROJECT_USE_HAL",
                  "condition": "$value === 'HAL'",
                  "semaphore": true
                }
              ]
            },
            "init_type": {
              "type": "string",
              "title": "Resource initialization code generation",
              "description": "Pick whether the initialization code should be generated and automatically called at startup.",
              "oneOf": [
                {
                  "title": "Callable",
                  "const": "called",
                  "description": "Initialization code is generated and called in peripheral initialization."
                },
                {
                  "title": "Generated",
                  "const": "enabled",
                  "description": "Initialization code is generated but not called in peripheral initialization."
                },
                {
                  "title": "Not generated",
                  "const": "disabled",
                  "description": "Initialization code is not generated."
                }
              ],
              "default": "called"
            },
            "usb_mode": {
              "type": "string",
              "title": "Mode used by the component",
              "description": "This component is a standard component which can be used HW instance available on another component. The notion of function is used to distinguish the usage of each HW instance.",
              "actions": [
                {
                  "type": "disable",
                  "condition": "true"
                }
              ],
              "default": "PCD"
            }
          }
        },
        "basic": {
          "title": "Main features",
          "type": "object",
          "properties": {
            "core_speed": {
              "type": "string",
              "title": "USB core speed",
              "default": "SPEED_FS",
              "actions": [
                {
                  "type": "disable",
                  "condition": "true"
                }
              ]
            },
            "phy_interface": {
              "title": "PHY interface",
              "type": "string",
              "default": "PHY_EMBEDDED_FS",
              "actions": [
                {
                  "type": "disable",
                  "condition": "true"
                }
              ]
            },
            "pma_settings": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "title": "Packet memory area (PMA)",
              "items": {
                "type": "object",
                "title": "Endpoint details",
                "actions": [
                  {
                    "type": "error",
                    "condition": "($common.helper_usb_pma_total_size($basic.pma_settings, $common.helper_usb_get_index($basic.pma_settings, $item))) > 2048",
                    "message": "Cumulative PMA usage up to this endpoint exceeds 2048 bytes."
                  },
                  {
                    "type": "error",
                    "condition": "$common.helper_usb_ep_get_total_allocated_ep_number($basic.pma_settings, $common.helper_usb_get_index($basic.pma_settings, $item)) > $common.helper_usb_pma_total_possible_ep_number($basic.pma_settings)",
                    "message": "The total number of allocated endpoints exceeds the maximum possible number with the current PMA settings."
                  },
                  {
                    "type": "error",
                    "condition": "$common.helper_usb_get_total_allocated_ep_number($basic.pma_settings, $common.helper_usb_get_index($basic.pma_settings, $item)) > $common.helper_usb_pma_total_possible_ep_number($basic.pma_settings)",
                    "message": "The total number of allocated endpoints exceeds the maximum possible number with the current PMA settings."
                  }
                ],
                "properties": {
                  "number": {
                    "type": "integer",
                    "title": "Endpoint number",
                    "maximum": 7,
                    "description": "The endpoint number and its direction allow to compute the endpoint address. The direction is encoded in bit 7 of the address: 0x80 indicates an IN endpoint (device-to-host), while 0x00 indicates an OUT endpoint (host-to-device). Therefore, the endpoint address is (endpoint_number & 0x0F) | 0x80 for IN endpoints, and (endpoint_number & 0x0F) for OUT endpoints. For example, endpoint 3 IN is 0x83, and endpoint 3 OUT is 0x03.",
                    "display_format": [
                      "hex"
                    ],
                    "actions": [
                      {
                        "type": "set",
                        "condition": "true",
                        "computed":
                        {
                          "default": "$common.helper_usb_set_current_ep_number($basic.pma_settings,  $common.helper_usb_get_index($basic.pma_settings, $item))"
                        }
                      }
                    ],
                    "minimum": 0
                  },
                  "direction": {
                    "type": "string",
                    "title": "Endpoint direction",
                    "oneOf": [
                      {
                        "title": "IN (from device to host)",
                        "const": "IN"
                      },
                      {
                        "title": "OUT (from host to device)",
                        "const": "OUT"
                      }
                    ],
                    "actions": [
                      {
                        "type": "set",
                        "condition": "true",
                        "computed":
                        {
                          "default": "$common.helper_usb_set_current_ep_direction($basic.pma_settings,  $common.helper_usb_get_index($basic.pma_settings, $item))"
                        }
                      }
                    ]
                  },
                  "buffer_type": {
                    "type": "string",
                    "title": "Endpoint buffer type",
                    "oneOf": [
                      {
                        "title": "Single buffer",
                        "const": "single"
                      },
                      {
                        "title": "Double buffer",
                        "const": "double"
                      }
                    ],
                    "actions": [
                      {
                          "type": "disable",
                          "condition": "$item.number === 0"
                      }
                    ],
                    "default": "single"
                  },
                  "size": {
                    "type": "integer",
                    "title": "Buffer size",
                    "default": 64,
                    "maximum": 256,
                    "display_format": [
                      "hex",
                      "dec"
                    ],
                    "minimum": 1
                  },
                "buffer_address": {
                  "type": "string",
                  "title": "Buffer address",
                  "description": "Address in PMA where the buffer is located. It is computed automatically.",
                  "default": "0x00",
                  "pattern": "^0x[0-9A-Fa-f]{1,4}$",
                  "actions": [
                    {
                      "type": "disable"
                    },
                    {
                      "type": "set",
                      "condition": "true",
                      "computed":
                      {
                        "const": "'0x' + ($common.helper_usb_ep_calc_address($basic.pma_settings, $common.helper_usb_get_index($basic.pma_settings, $item), 0, true))"
                      }
                    }
                  ]
                },
                "size1": {
                  "type": "integer",
                  "title": "Second Buffer size",
                  "default": 64,
                  "maximum": 2048,
                  "display_format": [
                    "hex",
                    "dec"
                  ],
                  "minimum": 1,
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "$item.buffer_type === \"single\""
                    }
                  ]
                },
                "buffer_address1": {
                  "type": "string",
                  "title": "Second Buffer address",
                  "description": "Address in PMA (Packet Memory Area) where the second buffer is located.",
                  "default": "0x00",
                  "pattern": "^0x[0-9A-Fa-f]{1,4}$",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "$item.buffer_type === \"single\""
                    },
                    {
                      "type": "disable"
                    },
                    {
                      "type": "set",
                      "condition": "true",
                      "computed":
                      {
                        "const": "'0x' + ($common.helper_usb_ep_calc_address($basic.pma_settings, $common.helper_usb_get_index($basic.pma_settings, $item), 1, true))"
                      }
                    }
                  ]
                }
              }
              }
            }
          }
        },
        "additional": {
          "type": "object",
          "title": "Advanced features",
          "properties": {
            "bcd_state": {
              "type": "boolean",
              "title": "USB battery charging device state",
              "default": false
            },
            "lpm_enable": {
              "type": "boolean",
              "title": "USB Low power management state",
              "default": false
            },
            "bulk_doublebuffer_enable": {
              "type": "boolean",
              "title": "USB Bulk double buffer state",
              "default": false
            }
          }
        },
        "system": {
          "type": "object",
          "title": "System",
          "description": "PCD Global Configuration Structure definition.",
          "properties": {
            "gpio": {
              "type": "object",
              "title": "GPIO",
              "description": "GPIO settings.",
              "properties": {
                "dp": {
                  "type": "object",
                  "title": "USB D+ pin",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.name",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "!$get('pinout.peripheralCanBeMapped', $resource.name, 'DP')"
                    },
                    {
                      "type": "warning",
                      "message": "This parameter's basic configuration is automatically done",
                      "condition": "$resource.name === 'OTG_FS'"
                    }
                  ],
                  "needs": [
                    {
                      "selector": "DP",
                      "constraints": {
                        "mode": {
                          "const": "ANALOG"
                        },
                        "pull": {
                          "const": "No"
                        },
                        "speed": {
                          "const": "High"
                        }
                      }
                    }
                  ]
                },
                "dm": {
                  "type": "object",
                  "title": "USB D- pin",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.name",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "!$get('pinout.peripheralCanBeMapped', $resource.name, 'DM')"
                    },
                    {
                      "type": "warning",
                      "message": "This parameter's basic configuration is automatically done",
                      "condition": "$resource.name === 'OTG_FS'"
                    }
                  ],
                  "needs": [
                    {
                      "selector": "DM",
                      "constraints": {
                        "mode": {
                          "const": "ANALOG"
                        },
                        "pull": {
                          "const": "No"
                        },
                        "speed": {
                          "const": "High"
                        }
                      }
                    }
                  ]
                }
              }
            },
            "nvic": {
              "type": "object",
              "title": "NVIC",
              "properties": {
                "enable_interruption": {
                  "type": "boolean",
                  "title": "Global interrupt",
                  "actions": [
                    {
                      "type": "warning",
                      "condition": "$value == false",
                      "message": "Disabling the interrupt will prevent the USB peripheral from functioning properly."
                    }
                  ],
                  "default": true
                },
                "irq_handler_generation": {
                  "type": "boolean",
                  "title": "IRQ handler generation",
                  "default": true,
                  "synchronize": true,
                  "synchronizeOn": {
                    "path": "irq_handler_generation",
                    "component": "HAL-USB"
                  },
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.nvic.enable_interruption && $info.layer === 'HAL'"
                    }
                  ]
                },
                "nvic_config": {
                  "type": "object",
                  "title": "NVIC USB global",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.nvic.enable_interruption"
                    }
                  ],
                  "type": "object",
                  "objectType": "need.interrupt.lines",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_CORTEX_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.name",
                  "needs": [
                    {
                      "selector": "*"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}