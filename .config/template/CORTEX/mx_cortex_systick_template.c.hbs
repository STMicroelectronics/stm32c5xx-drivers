system_status_t mx_cortex_systick_init(void)
{
  system_status_t status = SYSTEM_OK;

  HAL_CORTEX_SYSTICK_Suspend();

      {{~#with system.nvic}}
        {{#if (and enable_interruption (eq enable_interruption true))}}


{{> CORTEX fct='cortex_system_lines' system_line='SysTick'}}
          {{~assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context @root.nvic_context irq_config1.needs @root.current_resource irq_handler_generation)}}
        {{~/if}}
      {{~/with}}{{! system.nvic}}


  HAL_CORTEX_SYSTICK_SetClkSource(HAL_CORTEX_SYSTICK_CLKSOURCE_{{basic.clock_source}});

  if (HAL_CORTEX_SYSTICK_SetFreq(HAL_TICK_FREQ_{{basic.tick_frequency}}) != HAL_OK)
  {
    status = SYSTEM_PERIPHERAL_ERROR;
  }

  {{#if (not (and system.nvic.enable_interruption (eq system.nvic.enable_interruption true)))}}
  /* Systick interruption is enabled during HAL_CORTEX_SYSTICK_SetFreq */
  HAL_CORTEX_SYSTICK_Suspend();
  {{/if}}

  return status;
}

void mx_cortex_systick_deinit(void)
{
  HAL_CORTEX_SYSTICK_Suspend();
  SysTick_Disable();
}

    {{else}}
{{!
    Generation of initialization function used in LL
~}}
system_status_t mx_cortex_systick_init(void)
{
  uint32_t systick_frequency = 0U;

  SysTick_DisableIT();

      {{~#with system.nvic}}
        {{#if (and enable_interruption (eq enable_interruption true))}}


{{> CORTEX fct='cortex_system_lines' system_line='SysTick'}}
          {{~assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context @root.nvic_context irq_config1.needs @root.current_resource false)}}
        {{~/if}}
      {{~/with}}{{! system.nvic}}

      {{#if (eq basic.clock_source "INTERNAL")}}
  /* Set the SysTick clock source to internal */
  SysTick_SetClkSource(SysTick_CTRL_CLKSOURCE_Msk);

  /* The SysTick clock source is the CPU clock, get the CPU clock frequency */
  systick_frequency = {{> RCC fct='generate_systick_frequency_computation' external=false}};
      {{else}}{{! external clock source }}
  /* Set the SysTick clock source to external */
  SysTick_SetClkSource(0);

  /* The SysTick clock source is external (RCC). Get its frequency */
  systick_frequency = {{> RCC fct='generate_systick_frequency_computation' external=true}};
      {{/if}}{{! clock_source == INTERNAL }}

  {{#if (eq basic.tick_frequency "10HZ")}}
  systick_frequency /= 100U;
  {{else if (eq basic.tick_frequency "100HZ")}}
  systick_frequency /= 10U;
  {{/if}}{{! tick_frequency == 10HZ}}

  /* Set the SysTick reload counter according to the ticks frequency */
  if (SysTick_SetReload(systick_frequency) == 1U)
  {
    /* Reload value impossible */
    return SYSTEM_PERIPHERAL_ERROR;
  }

  /* Load the SysTick counter Value */
  SysTick_SetCounter(0UL);

  SysTick_Enable();
  {{#if (and system.nvic.enable_interruption (eq system.nvic.enable_interruption true))}}
  SysTick_EnableIT();
  {{/if}}

  return SYSTEM_OK;
}

void mx_cortex_systick_deinit(void)
{
  SysTick_DisableIT();
  SysTick_Disable();
}

