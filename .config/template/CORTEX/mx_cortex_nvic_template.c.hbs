{{#helper_common_beautifier}}
{{~assign "strategy" (@root.EnvVarAPI.getVariableValue 'SYSTEM_PROJECT_CODEGEN_STRATEGY')~}}
{{~log "strategy" @root.strategy~}}
{{!#if (eq @root.strategy "SW")}}
  {{~assign 'current_resource' 'CORTEX_NVIC'~}}
  {{~assign 'instances' (@root.SWConfigurationAPI.getInstances 'STMicroelectronics::Device:STM32CubeMX2 Config:CORTEX NVIC')~}}
{{!else}}
  {{!~assign "strategy" 'HW'~}}
  {{!#get_myctx~}}
    {{!#with _myctx~}}
      {{!~log "CORTEX NVIC template _myctx:" this~}}
      {{!~assign 'current_resource' resource~}}
      {{!~assign 'instances' instances~}}
    {{!/with~}}
  {{!/get_myctx~}}
{{!/if}}
{{~log "CORTEX NVIC template current_resource:" @root.current_resource~}}
{{~log "CORTEX NVIC template instances:" (toJSON @root.instances)~}}
{{> SYSTEM fct='system_check_ll_optim'}}
/**
  ******************************************************************************
  * @file           : mx_{{lowercase @root.current_resource}}.c
  * @brief          : {{@root.current_resource}} Peripheral initialization
{{> LICENSE}}


/* Includes ------------------------------------------------------------------*/
#include "mx_{{lowercase @root.current_resource}}.h"

/* Private typedef -----------------------------------------------------------*/
/* Private define ------------------------------------------------------------*/
/* Private macro -------------------------------------------------------------*/
/* Private variables ---------------------------------------------------------*/
/* Private functions prototype------------------------------------------------*/
/* Exported variables by reference--------------------------------------------*/
{{#each @root.instances~}}
  {{#if (eq @root.strategy "SW")}}
    {{~assign 'cortex_nvic_cxt' (@root.SWConfigurationAPI.getSwInstanceConfiguration this)~}}
    {{~log "CORTEX NVIC template cortex_nvic_cxt:" (toJSON @root.cortex_nvic_cxt)~}}
    {{~assign 'current_resource' (@root.peripheralsResourceManagerAPI.getPeripheralBoundToSoftwareInstance this)~}}
    {{~assign 'current_layer' @root.cortex_nvic_cxt.info.layer~}}
    {{~log "CORTEX NVIC template current_resource:" @root.current_resource~}}
  {{else}}
    {{~assign 'current_layer' info.layer~}}
  {{/if}}
{{/each}}
{{helper_common_initialize_index~}}
{{~assign 'current_index' (helper_common_get_index @root.current_resource)~}}
{{~assign 'nvic_context' 'undefined'~}}
{{#each @root.instances}}
  {{!#if (eq @root.strategy "SW")}}
    {{~assign 'cortex_nvic_cxt' (@root.SWConfigurationAPI.getSwInstanceConfiguration this)~}}
    {{~assign 'current_resource' (@root.peripheralsResourceManagerAPI.getPeripheralBoundToSoftwareInstance this)~}}
    {{~assign 'name' @root.cortex_nvic_cxt.name~}}
    {{~assign 'current_layer' @root.cortex_nvic_cxt.info.layer~}}
    {{~assign 'current_index' (helper_common_get_index @root.current_resource)~}}
  {{!else}}
    {{!~assign 'name' name~}}
    {{!~assign 'current_layer' info.layer~}}
    {{!~assign 'cortex_nvic_cxt' this}}
  {{!/if}}
  {{! Initialize the context for LL code optimization ~}}
  {{!~assign 'lut_table' (helper_cortex_nvic_get_lut_table 'CORTEX NVICV1')~}}
  {{!~helper_common_initialize_ll_code @root.optim_enable @root.lut_table @root.current_resource~}}
  {{~log "CORTEX NVIC template instance:" (toJSON this)}}

/******************************************************************************/
/* Exported functions for {{@root.current_resource}} in {{@root.current_layer}} layer (SW instance {{@root.name}}) */
/******************************************************************************/
  {{~assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer @root.current_index)~}}
  {{~assign 'current_index' (helper_common_inc_index @root.current_resource)}}
  {{#with @root.cortex_nvic_cxt}}
system_status_t mx_cortex_nvic_init(void)
{
  {{~#with system.nvic}}
    {{#if irq_config1.needs}}
      {{~assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context @root.nvic_context irq_config1.needs @root.current_resource false)}}
    {{~/if}}
    {{#if irq_config2.needs}}
      {{~assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context @root.nvic_context irq_config2.needs @root.current_resource false)}}
    {{~/if}}
    {{~#if enable_exception_debugmon}}

  /* Enable DebugMonitor exception */
  STM32_SET_BIT(DCB->DEMCR, DCB_DEMCR_MON_EN_Msk);
      {{~assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context @root.nvic_context irq_config3.needs @root.current_resource false)}}
    {{~/if}}
  {{~/with}}{{! system.nvic}}

{{> CORTEX fct='cortex_system_lines' system_line='NVIC'}}


  return SYSTEM_OK;
}

    {{#if (eq @root.current_layer 'HAL')}}
{{!
    Generation of initialization function used in HAL
~}}
      {{~assign 'shared_interrupts' (helper_cortex_nvic_get_shared_irq_lines @root.NvicAPI)}}
      {{~#each @root.shared_interrupts}}
        {{~assign 'is_interrupt' isInterrupt}}
        {{~assign 'name' name}}


/******************************************************************************/
/*            {{description}}                    */
/******************************************************************************/
void {{name}}_{{#if isInterrupt}}IRQ{{/if}}Handler(void)
{
        {{~#each shared_with}}
          {{~#if @root.is_interrupt}}

  {{this}}_{{@root.name}}_IRQHandler();
          {{~else}}

  if (SYSTEM_OK == {{this}}_{{@root.name}}_IRQHandler())
  {
    return;
  }
          {{~/if}}
        {{~/each}}
        {{~#if (not isInterrupt)}}


  while(1);
        {{~/if}}

}
      {{~/each}}{{!shared_interrupts}}
    {{else}}
{{!
    Generation of initialization function used in LL
~}}
      {{~assign 'shared_interrupts' (helper_cortex_nvic_get_shared_irq_lines @root.NvicAPI)}}
      {{~#each @root.shared_interrupts}}


/******************************************************************************/
/*    {{description}} is managed directly in user code.   */
/******************************************************************************/
__WEAK void {{name}}_{{#if isInterrupt}}IRQ{{/if}}Handler(void)
{
  /* NOTE : This function must not be modified in this file, when the IRQHandler is needed,
            the function must preferably be implemented in the user file
   */

  while(1);
}
      {{~/each}}{{!shared_interrupts}}
    {{~/if}}
  {{~/with}}
{{/each}}

