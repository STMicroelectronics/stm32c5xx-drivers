{{#helper_common_beautifier}}
{{assign "strategy" (@root.EnvVarAPI.getVariableValue 'SYSTEM_PROJECT_CODEGEN_STRATEGY')~}}
{{log "strategy" @root.strategy~}}
{{#if (eq @root.strategy "SW")}}
{{assign 'current_resource' 'HASH'~}}
{{assign 'instances' (@root.SWConfigurationAPI.getInstances 'STMicroelectronics::Device:STM32CubeMX2 Config:HASH')~}}
{{else}}
{{assign "strategy" 'HW'~}}
{{#get_myctx~}}
{{#with _myctx~}}
{{log "HASH template _myctx:" this~}}
{{assign 'current_resource' resource~}}
{{assign 'instances' instances~}}
{{/with~}}
{{/get_myctx~}}
{{/if}}
{{log "HASH template current_resource:" @root.current_resource~}}
{{log "HASH template instances:" (toJSON @root.instances)~}}
/**
  ******************************************************************************
  * @file           : mx_{{lowercase @root.current_resource}}.c
  * @brief          : {{@root.current_resource}} Peripheral initialization
{{> LICENSE}}

/* Includes ------------------------------------------------------------------*/
#include "mx_{{lowercase @root.current_resource}}.h"
{{> RCC fct='include_rcc'}}

/* Private typedef -----------------------------------------------------------*/
/* Private define ------------------------------------------------------------*/
/* Private macros ------------------------------------------------------------*/
/* Private variables ---------------------------------------------------------*/
/* Private functions prototype------------------------------------------------*/
/* Exported variables by reference--------------------------------------------*/
{{assign 'hal_handle_exist' 0~}}
{{#each @root.instances~}}
{{#if (eq @root.strategy "SW")}}
{{assign 'hash_cxt' (@root.SWConfigurationAPI.getInstanceConfiguration this)~}}
{{log "HASH template hash_cxt:" (toJSON @root.hash_cxt)~}}
{{assign 'current_resource' (@root.peripheralsResourceManagerAPI.getPeripheralBoundToSoftwareInstance this)~}}
{{assign 'current_layer' @root.hash_cxt.settings.parameters.info.layer~}}
{{log "HASH template current_resource:" @root.current_resource~}}
{{else}}
{{assign 'current_layer' info.layer~}}
{{/if}}
{{#if (eq @root.current_layer 'HAL')~}}
{{#if (eq @root.hal_handle_exist 0)~}}
static hal_hash_handle_t h{{@root.current_resource}};
{{assign 'hal_handle_exist' 1~}}
{{/if}}
{{/if}}
{{#if basic.use_hmac_feature}}
{{~assign 'key' (helper_hash_string_to_hex basic.key_settings.hmac_key)~}}
uint8_t input_key[{{basic.key_settings.key_size}}] = { {{@root.key}} };
{{/if}}{{~!basic.use_hmac_feature}}
{{/each}}
{{> DMA_HAL fct='get_dma_handles' resource=@root.current_resource}}

{{assign 'hal_handle_exist' 0~}}
{{assign 'nvic_context' 'undefined'~}}
{{#each @root.instances}}
{{#if (eq @root.strategy "HW")}}
{{assign 'name' name~}}
{{assign 'current_layer' info.layer~}}
{{assign 'configs' this~}}
{{else}}
{{assign 'hash_cxt' (@root.SWConfigurationAPI.getInstanceConfiguration this)~}}
{{assign 'current_resource' (@root.peripheralsResourceManagerAPI.getPeripheralBoundToSoftwareInstance this)~}}
{{assign 'name' @root.hash_cxt.name~}}
{{assign 'current_layer' @root.hash_cxt.settings.parameters.info.layer~}}
{{assign 'configs' @root.hash_cxt.settings.parameters~}}
{{/if}}
/******************************************************************************/
/* Exported functions for HASH in {{@root.current_layer}} layer (SW instance {{#if (eq name undefined)}}{{instanceIndex}}{{else}}{{name}}{{/if}}) */
/******************************************************************************/
{{#with @root.configs}}
{{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer undefined)~}}
{{!
    Generation of initialization function used in HAL
~}}
{{#if (eq @root.current_layer 'HAL')}}
hal_hash_handle_t *{{@root.fct_name}}_init(void)
{
{{#if (not basic.use_hmac_feature)}}
  hal_hash_config_t config;
{{else}}
  hal_hash_hmac_config_t config;
{{/if}}{{~!use_hmac_feature}}
  if (HAL_HASH_Init(&h{{@root.current_resource}}, HAL_HASH) != HAL_OK)
  {
    return NULL;
  }
{{> RCC fct='generate_kernel_clock' hw_resource=@root.current_resource sw_resource='HASH'}}
{{> RCC fct='generate_peripheral_clock_activation' hw_resource=@root.current_resource}}
{{#with basic}}
  config.data_swapping = HAL_HASH_DATA_SWAP_{{data_swapping}};
  config.algorithm     = HAL_HASH_ALGO_{{algo}};
{{#if use_hmac_feature}}
  config.p_hmac_key         = input_key;
  config.key_size_byte = {{key_settings.key_size}};
{{/if}}{{~!use_hmac_feature~}}
  {{assign 'found_SetConfig' true~}}
{{#if (not use_hmac_feature)}}
  if (HAL_HASH_SetConfig(&h{{@root.current_resource}}, &config) != HAL_OK)
  {
    return NULL;
  }
{{else}}
  if (HAL_HASH_HMAC_SetConfig(&h{{@root.current_resource}}, &config) != HAL_OK)
  {
    return NULL;
  }
{{/if}}{{~!use_hmac_feature}}
{{/with~}}{{~!basic~}}

{{#if system.dma.enable_dma}}
  /* DMA Configuration ********************************************************/
{{> DMA_HAL fct='init' needs=system.dma_config.needs}}
  /* Link the DMA handle to the HASH handle */
  if (HAL_HASH_SetInDMA(&h{{@root.current_resource}}, &h{{@root.dma_channel_instance}}) != HAL_OK)
  {
    return NULL;
  }
{{/if}}
{{#if (and system.nvic.enable_interruption (eq system.nvic.enable_interruption true))}}
  /* Enable the interruption for HASH */
{{assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context @root.nvic_context system.nvic.irq_config.needs @root.current_resource system.nvic.irq_handler_generation)~}}
{{> CORTEX fct='init' layer=@root.current_layer needs=system.nvic.irq_config.needs}}
{{/if}}
  return &h{{@root.current_resource}};
}

void {{@root.fct_name}}_deinit(void)
{
{{#if (and system.nvic.enable_interruption (eq system.nvic.enable_interruption true))}}
  /* Disable the interuption for HASH */
{{> CORTEX fct='deinit' layer=@root.current_layer needs=system.nvic.irq_config.needs}}
{{/if}}

  (void)HAL_HASH_DeInit(&h{{@root.current_resource}});

{{> RCC fct='generate_peripheral_clock_reset' hw_resource=@root.current_resource}}
{{> RCC fct='generate_peripheral_clock_deactivation' hw_resource=@root.current_resource}}

{{#with system}}
{{#with dma}}
{{#if enable_dma}}
{{> DMA_HAL fct='deinit' needs=dma_config.needs}}
{{/if}}
{{/with}}
{{/with}}
}

{{/if~}}

{{#if (eq @root.current_layer 'HAL')~}}
{{#if (eq @root.hal_handle_exist 0)~}}
{{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer undefined)~}}
{{!
    Generation of getHandle functions used in HAL
~}}
hal_hash_handle_t *{{@root.fct_name}}_gethandle(void)
{
  return &h{{@root.current_resource}};
}
{{assign 'hal_handle_exist' 1~}}
{{/if}}
{{/if}}

{{/with}}
{{/each}}

{{> CORTEX fct='generate_irqhandler' type='implementation' component='HASH'}}
{{/helper_common_beautifier}}
