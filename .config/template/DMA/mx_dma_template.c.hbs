{{#helper_common_beautifier}}
{{assign "strategy" (@root.SWProjectAPI.getSelectedGenerationStrategy)~}}
{{#get_myctx~}}
{{#with _myctx~}}
{{!log "DMA template _myctx:" this~}}
{{#if (eq @root.strategy "SW")}}
{{assign 'current_resource' 'DMA'~}}
{{else}}
{{assign 'current_resource' resource~}}
{{/if}}
{{log "DMA template current_resource:" @root.current_resource~}}
/**
  ******************************************************************************
  * @file           : mx_{{lowercase @root.current_resource}}.c
  * @brief          : Provides {{@root.current_resource}} services
{{> LICENSE}}

/* Includes ----------------------------------------------------------------------------------------------------------*/
#include "mx_{{lowercase @root.current_resource}}.h"

/* Exported variables by reference------------------------------------------------------------------------------------*/
{{#if (eq @root.strategy "SW")}}
{{assign 'instances' (@root.SWConfigurationAPI.getInstances 'STMicroelectronics::Device:STM32CubeMX2 Config:DMA')~}}
{{else}}
{{assign 'instances' instances~}}
{{/if}}

{{#each @root.instances~}}
{{#if (eq @root.strategy "SW")}}
{{assign 'dma_cxt' (@root.SWConfigurationAPI.getSwInstanceConfiguration this)~}}
{{assign 'current_layer' @root.dma_cxt.info.layer~}}
{{~assign 'current_resource' (@root.DmaAPI.getResourceBoundToStandalone this)~}}
{{~assign 'current_resource' @root.current_resource.resourceId~}}
{{else}}
{{assign 'current_layer' info.layer~}}
{{/if}}
{{#if (eq @root.current_layer 'HAL')}}
static hal_dma_handle_t h{{@root.current_resource}};
{{/if}}
{{/each}}

{{assign 'current_index' 0~}}
{{assign 'nvic_context' 'undefined'~}}
{{#each @root.instances}}
{{#if (eq @root.strategy "HW")}}
{{assign 'name' name~}}
{{assign 'current_layer' info.layer~}}
{{assign 'configs' this~}}
{{else}}
{{assign 'dma_cxt' (@root.SWConfigurationAPI.getSwInstanceConfiguration this)~}}
{{~assign 'current_resource' (@root.DmaAPI.getResourceBoundToStandalone this)~}}
{{~assign 'current_resource' @root.current_resource.resourceId~}}

{{assign 'name' @root.dma_cxt.name~}}
{{assign 'current_layer' @root.dma_cxt.info.layer~}}
{{assign 'configs' @root.dma_cxt~}}
{{assign 'current_index' (helper_common_get_index @root.current_resource)~}}
{{/if}}
{{#with @root.configs}}
/**********************************************************************************************************************/
/* Exported functions for {{@root.current_resource}} in {{@root.current_layer}} layer */
/**********************************************************************************************************************/
{{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer @root.current_index)~}}
{{assign 'current_index' (add @root.current_index 1)~}}
{{!
    Generation of initialization function used in HAL
~}}
{{#if (eq @root.current_layer 'HAL')}}
/**
  * @brief  Initialize and configure the {{lowercase @root.current_resource}} (configuration {{@root.current_index}}) through {{@root.current_layer}} layer.
  * @retval Pointer to hal_dma_handle_t structure.
  */
hal_dma_handle_t *{{@root.fct_name}}_init(void)
{
{{> DMA_HAL fct='init_dma' arg1=@root.current_resource arg2=this}}
  return &h{{@root.current_resource}};
}

/**
  * @brief  DeInitialize the {{lowercase @root.current_resource}} (configuration {{@root.current_index}}) through {{@root.current_layer}} layer.
  */
void {{@root.fct_name}}_deinit(void)
{
{{#if system.enable_interruption}}
  /* Disable the interruption for {{@root.current_resource}} */
{{#> CORTEX fct='deinit' layer=@root.current_layer}}
{{/CORTEX}}

{{/if}}
  (void)HAL_DMA_DeInit(&h{{@root.current_resource}});
}

{{else}}
{{!
    Generation of initialization function used in LL
~}}
DMA_Channel_TypeDef *{{@root.fct_name}}_init(void)
{
{{> DMA_LL fct='init_dma' arg1=@root.current_resource arg2=this}}
{{#if system.enable_interruption}}
  /* Enable the interruption for {{@root.current_resource}} */
{{#> CORTEX fct='init' layer=@root.current_layer needs=system.nvic.nvic_config.needs}}
#warning "Partial HAL CORTEX is not present"
{{/CORTEX}}
{{/if}}
  return {{@root.current_resource}};
}

void {{@root.fct_name}}_deinit(void)
{
{{#if system.enable_interruption}}
  /* Disable the interruption for {{@root.current_resource}} */
{{#> CORTEX fct='deinit' layer=@root.current_layer}}
{{/CORTEX}}

{{/if}}
  /* De-initialize the DMA channel */
  LL_DMA_DisableChannel({{@root.current_resource}});
  LL_DMA_ClearFlag({{@root.current_resource}}, LL_DMA_FLAG_ALL);

  LL_DMA_WRITE_REG({{@root.current_resource}}, CCR, 0U);
  LL_DMA_WRITE_REG({{@root.dma_channel_instance}}, CTR1, 0U);
  LL_DMA_WRITE_REG({{@root.current_resource}}, CTR2, 0U);
  LL_DMA_WRITE_REG({{@root.current_resource}}, CBR1, 0U);
  LL_DMA_WRITE_REG({{@root.current_resource}}, CLLR, 0U);
}

{{/if}}
{{#if (eq @root.current_layer 'HAL')}}
{{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer undefined)~}}
{{!
    Generation of getHandle functions used in HAL
~}}
/**
  * @brief  Get the {{@root.current_resource}} object.
  */
hal_dma_handle_t *{{@root.fct_name}}_gethandle(void)
{
  return &h{{@root.current_resource}};
}
{{/if}}
{{/with~}}
{{/each}}
{{assign 'irq_info_list' (helper_cortex_nvic_get_irqline_info_list @root.NvicAPI @root.nvic_context 'DMA')~}}
{{#each @root.irq_info_list}}
{{#if generate_handler}}
/******************************************************************************/
/* {{description}} */
/******************************************************************************/
void {{line}}_IRQHandler(void)
{
  HAL_{{component}}_IRQHandler(&h{{resource_hw}});
}

{{else}}
/******************************************************************************/
/* {{description}} */
/*
void {{line}}_IRQHandler(void)
{
}
 */
/******************************************************************************/
{{/if}}
{{/each}}
{{/with~}}
{{/get_myctx~}}
{{/helper_common_beautifier}}
