{{#helper_common_beautifier}}

{{assign "strategy" (@root.EnvVarAPI.getVariableValue 'SYSTEM_PROJECT_CODEGEN_STRATEGY')~}}
{{log "strategy" @root.strategy~}}
{{#if (eq @root.strategy "SW")}}
{{assign 'current_resource' 'PKA'~}}
{{assign 'instances' (@root.SWConfigurationAPI.getInstances 'STMicroelectronics::Device:STM32CubeMX2 Config:PKA Init')~}}
{{log "log" @root.instances~}}
{{else}}
{{assign "strategy" 'HW'~}}
{{#get_myctx~}}
{{#with _myctx~}}
{{log "PKA template _myctx:" this~}}
{{assign 'current_resource' resource~}}
{{assign 'instances' instances~}}
{{/with~}}
{{/get_myctx~}}
{{/if}}
{{log "PKA template current_resource:" @root.current_resource~}}
{{log "PKA template instances:" (toJSON @root.instances)~}}
/**
  ******************************************************************************
  * @file           : mx_{{lowercase @root.current_resource}}.c
  * @brief          : {{@root.current_resource}} Peripheral initialization
{{> LICENSE}}

/* Includes ------------------------------------------------------------------*/
#include "mx_{{lowercase @root.current_resource}}.h"
{{> RCC fct='include_rcc'}}

/* Private typedef -----------------------------------------------------------*/
/* Private define ------------------------------------------------------------*/
/* Private macro -------------------------------------------------------------*/
/* Private variables ---------------------------------------------------------*/
/* Private functions prototype------------------------------------------------*/
/* Exported variables by reference--------------------------------------------*/
{{assign 'hal_handle_exist' 0~}}
{{#each @root.instances~}}
{{#if (eq @root.strategy "SW")}}
{{assign 'pka_cxt' (@root.SWConfigurationAPI.getSwInstanceConfiguration this)~}}
{{log "PKA template pka_cxt:" (toJSON @root.pka_cxt)~}}
{{assign 'current_resource' (@root.peripheralsResourceManagerAPI.getPeripheralBoundToSoftwareInstance this)~}}
{{assign 'current_layer' @root.pka_cxt.info.layer~}}
{{log "PKA template current_resource:" @root.current_resource~}}
{{else}}
{{assign 'current_layer' info.layer~}}
{{/if}}
{{#if (eq @root.current_layer 'HAL')}}
{{#if (eq @root.hal_handle_exist 0)}}
hal_pka_handle_t h{{@root.current_resource}};
{{assign 'hal_handle_exist' 1~}}
{{/if}}
{{/if}}
{{/each}}

{{assign 'hal_handle_exist' 0~}}
{{helper_common_initialize_index~}}
{{assign 'current_index' (helper_common_get_index @root.current_resource)~}}
{{assign 'nvic_context' 'undefined'~}}
{{#each @root.instances}}
{{#if (eq @root.strategy "HW")}}
{{assign 'name' name~}}
{{assign 'current_layer' info.layer~}}
{{else}}
{{assign 'pka_cxt' (@root.SWConfigurationAPI.getSwInstanceConfiguration this)~}}
{{assign 'current_resource' (@root.peripheralsResourceManagerAPI.getPeripheralBoundToSoftwareInstance this)~}}
{{assign 'name' @root.pka_cxt.name~}}
{{assign 'current_layer' @root.pka_cxt.info.layer~}}
{{assign 'current_index' (helper_common_get_index @root.current_resource)~}}
{{/if}}
{{assign 'rng_used' 0~}}
{{assign 'rngFilter' (JSONparse '{"cgroup": "STM32CubeMX2 Config", "csub": "RNG"}')~}}
{{assign 'rng_config' (@root.SWConfigurationAPI.getInstancesConfiguration @root.rngFilter)~}}
{{#if (gt (length @root.rng_config) 0)}}
{{assign 'rng_used' 1~}}
{{/if}}
/******************************************************************************/
/* Exported functions for {{@root.current_resource}} in {{@root.current_layer}} layer (SW instance {{@root.name}}) */
/******************************************************************************/
{{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer @root.current_index)~}}
{{assign 'current_index' (helper_common_inc_index @root.current_resource)~}}
{{!
    Generation of initialization function used in HAL
~}}
{{#if (eq @root.current_layer 'HAL')}}
hal_pka_handle_t *{{@root.fct_name}}_init(void)
{
  if (HAL_PKA_Init(&h{{@root.current_resource}}, HAL_{{uppercase @root.current_resource}}1) != HAL_OK)
  {
    return NULL;
  }

{{> RCC fct='generate_peripheral_clock_activation' hw_resource= 'RNG'}}
{{> RCC fct='generate_peripheral_clock_activation' hw_resource= 'PKA'}}
{{> RCC fct='generate_kernel_clock' hw_resource=@root.current_resource sw_resource='PKA'}}
{{#if (and system.nvic.enable_interruption (eq system.nvic.enable_interruption true))}}
  /* Enable the interruption for RNG */
{{assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context @root.nvic_context system.nvic.irq_config.needs @root.current_resource system.nvic.irq_handler_generation)~}}
{{> CORTEX fct='init' layer=@root.current_layer needs=system.nvic.irq_config.needs}}
{{/if}}
  return &h{{@root.current_resource}};
}

void {{@root.fct_name}}_deinit(void)
{
{{#if System_configuration.Interruption}}
  /* Disable the interruption for PKA */
{{#> CORTEX fct='deinit' layer=@root.current_layer}}
{{/CORTEX}}

{{/if}}
{{#if (eq @root.rcc_cxt.Clock_Tree.Peripher_clocks_init 1)}}
  (void)rcc_{{lowercase @root.current_resource}}_clock_deactivate();

{{/if}}
  (void)HAL_PKA_DeInit(&h{{@root.current_resource}});

{{> RCC fct='generate_peripheral_clock_reset' hw_resource=@root.current_resource}}
{{> RCC fct='generate_peripheral_clock_deactivation' hw_resource=@root.current_resource}}
  {{#if (not @root.rng_used)}}

{{> RCC fct='generate_peripheral_clock_deactivation' hw_resource='RNG'}}
  {{/if~}}
}

{{else}}
{{assign 'nvic_generate_handler' false~}}
{{!
    Generation of initialization function used in LL
~}}
PKA_TypeDef *{{@root.fct_name}}_init(void)
{
{{~#> RCC fct='generate_peripheral_clock_activation' hw_resource='RNG' ~}}
{{/RCC}}
{{#> RCC fct='generate_peripheral_clock_activation' hw_resource=@root.current_resource}}
{{/RCC}}
{{#> RCC fct='generate_kernel_clock' hw_resource=@root.current_resource sw_resource='PKA'}}
{{/RCC}}

{{#if (and system.nvic.enable_interruption (eq system.nvic.enable_interruption true))}}
  /* Enable the interruption for RNG */
{{assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context @root.nvic_context system.nvic.irq_config.needs @root.current_resource system.nvic.irq_handler_generation)~}}
{{> CORTEX fct='init' layer=@root.current_layer needs=system.nvic.irq_config.needs}}
{{/if}}
  return {{@root.current_resource}};
}

void {{@root.fct_name}}_deinit(void)
{
  {{~#if (not @root.rng_used)}}
{{> RCC fct='generate_peripheral_clock_deactivation' hw_resource='RNG' ~}}
  {{/if}}
{{> RCC fct='generate_peripheral_clock_deactivation' hw_resource=@root.current_resource}}
  {{#if System_configuration.Interruption}}

  /* Disable the interruption for PKA */
{{#> CORTEX fct='deinit' layer=@root.current_layer}}
{{/CORTEX}}
{{/if}}
}
{{/if}}
{{#if (eq @root.current_layer 'HAL')}}
{{#if (eq @root.hal_handle_exist 0)}}
{{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer undefined)~}}
{{!
    Generation of getHandle functions used in HAL
~}}
hal_pka_handle_t *{{@root.fct_name}}_gethandle(void)
{
  return &h{{@root.current_resource}};
}
{{assign 'hal_handle_exist' 1~}}
{{/if}}
{{/if}}
{{/each}}

{{> CORTEX fct='generate_irqhandler' type='implementation' component='PKA'}}
{{/helper_common_beautifier}}
