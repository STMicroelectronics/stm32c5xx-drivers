{{assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context system.nvic.irq_config.needs @root.nvic_context)~}}
{{> CORTEX fct='init' layer=@root.current_layer needs=system.nvic.irq_config.needs}}

{{/if}}
