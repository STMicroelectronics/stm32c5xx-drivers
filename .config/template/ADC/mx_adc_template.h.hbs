{{#helper_common_beautifier}}
{{assign "_define_" "#define"}}
{{#if (eq @root.strategy "SW")}}
  {{~assign 'file_name' 'ADC'~}}
  {{~assign 'instances' (@root.SWConfigurationAPI.getInstances 'STMicroelectronics::Device:STM32CubeMX2 Config:ADC')~}}
{{else}}
  {{#get_myctx~}}
    {{#with _myctx~}}
      {{~assign 'instances' instances~}}
    {{/with~}}
    {{/get_myctx~}}
  {{~assign 'current_resource' (get 'hw_resource')~}}
  {{~assign 'file_name' (get 'hw_resource')~}}
{{/if}}
/**
  ******************************************************************************
  * @file           : mx_{{lowercase @root.file_name}}.h
  * @brief          : Header for mx_{{lowercase @root.file_name}}.c file.
{{> LICENSE}}


/* Define to prevent recursive inclusion -------------------------------------*/
#ifndef MX_{{@root.file_name}}_H
#define MX_{{@root.file_name}}_H

#ifdef __cplusplus
extern "C" {
#endif /* __cplusplus */

/* Includes ------------------------------------------------------------------*/
{{assign "_define_" "#define"~}}
{{assign 'only_ll' true~}}
{{#each @root.instances~}}
{{#if (eq @root.strategy "HW")}}
{{assign 'current_layer' info.layer~}}
{{else}}
{{assign 'adc_cxt' (@root.SWConfigurationAPI.getSwInstanceConfiguration this)~}}
{{assign 'current_resource' (@root.peripheralsResourceManagerAPI.getPeripheralBoundToSoftwareInstance this)~}}
{{assign 'current_layer' @root.adc_cxt.info.layer~}}
{{/if}}
{{#if (eq @root.current_layer 'HAL')}}
{{assign 'only_ll' false~}}
{{/if}}
{{/each}}
{{#if @root.only_ll}}
#include "stm32_ll.h"
{{else}}
#include "stm32_hal.h"
{{/if}}

/* Exported types ------------------------------------------------------------*/
/* Exported constants --------------------------------------------------------*/
{{#each @root.instances}}
{{#if (eq @root.strategy "SW")}}
{{~assign 'adc_cxt' (@root.SWConfigurationAPI.getSwInstanceConfiguration this)~}}
{{~assign 'current_resource' (@root.peripheralsResourceManagerAPI.getPeripheralBoundToSoftwareInstance this)~}}
{{~assign 'current_layer' @root.adc_cxt.info.layer~}}
{{else}}
{{~assign 'current_layer' info.layer~}}
{{/if}}
{{#if (eq @root.current_layer 'LL')}}
#define USE_{{uppercase @root.current_resource}}
{{/if}}

{{assign 'desc_labels' 0}}
{{#each basic.channels as |channel|}}
  {{#each labels}}
    {{#if (length this)}}
      {{#if (eq @root.desc_labels 0)}}
        {{~assign 'desc_labels' 1}}
/* Aliases of channels labels */
      {{/if}}
        {{#if (eq @root.current_layer 'HAL')}}
{{@root._define_}} {{uppercase this}}_CHANNEL HAL_{{helper_adc_transform_channel_name channel._foreignKey}}
        {{else}}
{{@root._define_}} {{uppercase this}}_CHANNEL LL_{{helper_adc_transform_channel_name channel._foreignKey}}
        {{/if}}
    {{/if}}
  {{/each}}
{{/each~}}

{{helper_gpio_generate_aliases @root.pinoutAPI @root.current_resource @root.current_layer~}}
{{/each}}

/* Exported macros -----------------------------------------------------------*/
/* Exported variables --------------------------------------------------------*/
/* Exported functions ------------------------------------------------------- */
{{helper_common_initialize_index~}}
{{assign 'current_index' (helper_common_get_index @root.current_resource)~}}
{{#each @root.instances}}
  {{#if (eq @root.strategy "SW")}}
    {{~assign 'adc_cxt' (@root.SWConfigurationAPI.getSwInstanceConfiguration this)~}}
    {{~assign 'current_resource' (@root.peripheralsResourceManagerAPI.getPeripheralBoundToSoftwareInstance this)~}}
    {{~assign 'current_layer' @root.adc_cxt.info.layer~}}
    {{~assign 'current_index' (helper_common_get_index @root.current_resource)~}}
  {{else}}
    {{~assign 'current_layer' info.layer~}}
  {{/if}}
/******************************************************************************/
/* Exported functions for ADC in {{@root.current_layer}} layer */
/******************************************************************************/
{{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer @root.current_index)~}}
{{assign 'current_index' (helper_common_inc_index @root.current_resource)~}}
/**
  * @brief {{@root.fct_name}} init function
  * This function configures the hardware resources used in this example
  * @retval pointer to handle or NULL in case of failure
  */
{{#if (eq @root.current_layer 'HAL')}}
hal_adc_handle_t *{{@root.fct_name}}_init(void);

{{else}}
ADC_TypeDef *{{@root.fct_name}}_init(void);

{{/if}}
/**
  * @brief  De-initialize {{lowercase @root.current_resource}} instance and return it.
  */
void {{@root.fct_name}}_deinit(void);

{{#if (eq @root.current_layer 'HAL')}}
{{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer undefined)~}}
/**
  * @brief  Get the {{@root.current_resource}} object.
  * @retval Pointer on the {{@root.current_resource}} Handle
  */
hal_adc_handle_t *{{@root.fct_name}}_gethandle(void);

{{#if (not (eq @root.nvic_context 'undefined'))}}
{{> CORTEX fct='generate_irqhandler' type='prototype' component='ADC'}}
{{/if}}
{{/if}}

{{#if (eq @root.current_layer 'LL')}}
{{> DMA_LL fct='get_dma_lli_reg' resource=@root.dma_resource strategy=@root.strategy type='prototype'}}
{{/if}}

{{/each}}
#ifdef __cplusplus
}
#endif /* __cplusplus */

#endif /* MX_{{@root.file_name}}_H */
{{/helper_common_beautifier}}
