{{#helper_common_beautifier}}
{{#if (eq @root.strategy "SW")}}
  {{~assign 'file_name' 'I2C'~}}
  {{~assign 'instances' (@root.SWConfigurationAPI.getInstances 'STMicroelectronics::Device:STM32CubeMX2 Config:I2C')~}}
{{else}}
  {{#get_myctx~}}
    {{#with _myctx~}}
      {{~assign 'current_resource' resource~}}
      {{~assign 'file_name' resource~}}
      {{~assign 'instances' instances~}}
    {{/with~}}
    {{/get_myctx~}}
{{/if}}
/**
  ******************************************************************************
  * @file           : mx_{{lowercase @root.file_name}}.h
  * @brief          : Header for mx_{{lowercase @root.file_name}}.c file.
{{> LICENSE}}


/* Define to prevent recursive inclusion -------------------------------------*/
#ifndef MX_{{@root.file_name}}_H
#define MX_{{@root.file_name}}_H

#ifdef __cplusplus
extern "C" {
#endif /* __cplusplus */

/* Includes ------------------------------------------------------------------*/
{{assign 'only_ll' true~}}
{{#each @root.instances~}}
{{#if (eq @root.strategy "HW")}}
{{assign 'current_layer' info.layer~}}
{{else}}
{{assign 'i2c_cxt' (@root.SWConfigurationAPI.getInstanceConfiguration this)~}}
{{assign 'current_resource' (@root.peripheralsResourceManagerAPI.getPeripheralBoundToSoftwareInstance this)~}}
{{assign 'current_layer' @root.i2c_cxt.settings.parameters.info.layer~}}
{{/if}}
{{#if (eq @root.current_layer 'HAL')}}
{{assign 'only_ll' false~}}
{{/if}}
{{/each}}
{{#if @root.only_ll}}
#include "stm32_ll.h"
{{else}}
#include "stm32_hal.h"
{{/if}}

/* Exported types ------------------------------------------------------------*/
/* Exported constants --------------------------------------------------------*/
{{#each @root.instances}}
{{#if (eq @root.strategy "HW")}}
{{assign 'current_layer' info.layer~}}
{{assign 'configs' this~}}
{{else}}
{{assign 'i2c_cxt' (@root.SWConfigurationAPI.getSwInstanceConfiguration this)~}}
{{assign 'current_layer' @root.i2c_cxt.info.layer~}}
{{~assign 'current_resource' (@root.peripheralsResourceManagerAPI.getPeripheralBoundToSoftwareInstance this)~}}
{{assign 'configs' @root.i2c_cxt~}}
{{/if}}
{{#if (eq @root.current_layer 'LL')}}
#define USE_{{uppercase @root.current_resource}}
{{/if}}
{{helper_gpio_generate_aliases @root.pinoutAPI @root.current_resource @root.current_layer~}}
{{/each}}
/* Exported macros -----------------------------------------------------------*/
/* Exported variables --------------------------------------------------------*/
/* Exported functions ------------------------------------------------------- */
{{helper_common_initialize_index~}}
{{assign 'current_index' (helper_common_get_index @root.current_resource)~}}
{{#each @root.instances}}
  {{#if (eq @root.strategy "SW")}}
    {{~assign 'i2c_cxt' (@root.SWConfigurationAPI.getSwInstanceConfiguration this)~}}
    {{~assign 'current_resource' (@root.peripheralsResourceManagerAPI.getPeripheralBoundToSoftwareInstance this)~}}
    {{~assign 'current_layer' @root.i2c_cxt.info.layer~}}
    {{~assign 'current_index' (helper_common_get_index @root.current_resource)~}}
  {{else}}
    {{~assign 'current_layer' info.layer~}}
  {{/if}}
/******************************************************************************/
/* Exported functions for I2C in {{@root.current_layer}} layer */
/******************************************************************************/
{{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer @root.current_index "i2c")~}}
{{assign 'current_index' (helper_common_inc_index @root.current_resource)~}}
/**
  * @brief {{@root.fct_name}} init function
  * This function configures the hardware resources used in this example
  * @retval pointer to handle or NULL in case of failure
  */
{{#if (eq @root.current_layer 'HAL')}}
hal_i2c_handle_t *{{@root.fct_name}}_init(void);
{{else}}
I2C_TypeDef *{{@root.fct_name}}_init(void);
{{/if}}

/**
  * @brief  De-initialize {{lowercase @root.current_resource}} instance and return it.
  */
void {{@root.fct_name}}_deinit(void);

{{#if (eq @root.current_layer 'HAL')}}
{{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer @root.current_index "i2c")~}}
/**
  * @brief  Get the {{@root.current_resource}} object.
  * @retval Pointer on the {{@root.current_resource}} Handle
  */
hal_i2c_handle_t *{{@root.fct_name}}_gethandle(void);

{{/if}}
{{/each}}
{{> CORTEX fct='generate_irqhandler' type='prototype' component='I2C'}}
#ifdef __cplusplus
}
#endif /* __cplusplus */

#endif /* MX_{{@root.file_name}}_H */
{{/helper_common_beautifier}}
