{{/CORTEX~}}
{{/if}}
{{~/with~}}{{!nvic}}
{{~/with~}}{{!system}}
}

{{/if~}}{{! eq @root.current_layer 'HAL' ~}}

{{#if (eq @root.current_layer 'HAL')}}
{{#if (not (eq @root.nvic_context 'undefined'))}}
{{> CORTEX fct='generate_irqhandler' type='implementation' component='DAC'}}
{{/if}}
{{/if}}

{{#if (eq @root.current_layer 'LL')}}
  {{> DMA_LL fct='get_dma_lli_reg' resource=(concat @root.dma_resource '_CH1') strategy=@root.strategy type='implementation'}}
  {{> DMA_LL fct='get_dma_lli_reg' resource=(concat @root.dma_resource '_CH2') strategy=@root.strategy type='implementation'}}
{{/if}}

{{/with}}
{{/each~}}{{!instance~}}
{{/helper_common_beautifier}}
