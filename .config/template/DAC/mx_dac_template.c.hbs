{{#helper_common_beautifier}}
{{assign "strategy" (@root.EnvVarAPI.getVariableValue 'SYSTEM_PROJECT_CODEGEN_STRATEGY')~}}
{{log "strategy" @root.strategy~}}
{{#if (eq @root.strategy "SW")}}
  {{~assign 'current_resource' 'DAC'~}}
  {{~assign 'instances' (@root.SWConfigurationAPI.getInstances 'STMicroelectronics::Device:STM32CubeMX2 Config:DAC')~}}
  {{~assign 'dma_resource' 'STM32CubeMX2 Config:DAC'~}}
{{else}}
  {{~assign "strategy" 'HW'~}}
  {{#get_myctx~}}
    {{#with _myctx~}}
      {{~log "DAC template _myctx:" this~}}
      {{~assign 'current_resource' resource~}}
      {{~assign 'dma_resource' resource~}}
      {{~assign 'instances' instances~}}
    {{/with~}}
  {{/get_myctx~}}
{{/if}}
{{log "DAC template current_resource:" @root.current_resource~}}
{{log "DAC template instances:" (toJSON @root.instances)~}}
{{> SYSTEM fct='system_check_ll_optim'}}
/**
  ******************************************************************************
  * @file           : mx_{{lowercase @root.current_resource}}.c
  * @brief          : {{@root.current_resource}} Peripheral initialization
{{> LICENSE}}

/* Includes ------------------------------------------------------------------*/
#include "mx_{{lowercase @root.current_resource}}.h"
{{> RCC fct='include_rcc'}}

/* Private typedef -----------------------------------------------------------*/
/* Private define ------------------------------------------------------------*/
/* Private macro -------------------------------------------------------------*/
/* Private variables ---------------------------------------------------------*/
/* Private functions prototype------------------------------------------------*/
/* Exported variables by reference--------------------------------------------*/
{{#each @root.instances~}}
  {{#if (eq @root.strategy "SW")}}
    {{~assign 'dac_cxt' (@root.SWConfigurationAPI.getSwInstanceConfiguration this)~}}
    {{~log "DAC template dac_cxt:" (toJSON @root.dac_cxt)~}}
    {{~assign 'current_resource' (@root.peripheralsResourceManagerAPI.getPeripheralBoundToSoftwareInstance this)~}}
    {{~assign 'current_layer' @root.dac_cxt.info.layer~}}
    {{~log "DAC template current_resource:" @root.current_resource~}}
  {{else}}
    {{~assign 'current_layer' info.layer~}}
  {{/if}}
  {{#if (eq @root.current_layer 'HAL')}}
static hal_dac_handle_t h{{@root.current_resource}};
{{> GPIO_HAL fct='gpio_exti_get_variables' resource=@root.current_resource~}}
  {{else}}
{{> DMA_LL fct='get_dma_lli_variables' resource=(concat @root.dma_resource '_CH1') strategy=@root.strategy}}
{{> DMA_LL fct='get_dma_lli_variables' resource=(concat @root.dma_resource '_CH2') strategy=@root.strategy}}
  {{/if}}
{{/each}}
{{> DMA_HAL fct='get_dma_handles' resource=(concat @root.dma_resource '_CH1') strategy=@root.strategy}}
{{> DMA_HAL fct='get_dma_handles' resource=(concat @root.dma_resource '_CH2') strategy=@root.strategy}}

{{helper_common_initialize_index~}}
{{assign 'current_index' (helper_common_get_index @root.current_resource)~}}
{{assign 'nvic_context' 'undefined'~}}
{{assign 'nvic_generate_handler' true~}}
{{#each @root.instances}}
  {{#if (eq @root.strategy "HW")}}
    {{~assign 'name' name~}}
    {{~assign 'current_layer' info.layer~}}
    {{~assign 'dac_cxt' this}}
  {{else}}
    {{~assign 'dac_cxt' (@root.SWConfigurationAPI.getSwInstanceConfiguration this)~}}
    {{~assign 'current_resource' (@root.peripheralsResourceManagerAPI.getPeripheralBoundToSoftwareInstance this)~}}
    {{~assign 'name' @root.dac_cxt.name~}}
    {{~assign 'current_layer' @root.dac_cxt.info.layer~}}
    {{~assign 'current_index' (helper_common_get_index @root.current_resource)~}}
  {{/if}}
  {{~log "DAC template instance:" (toJSON this)~}}
{{! Initialize the context for LL code optimization ~}}
{{assign 'lut_table'   (helper_dac_get_lut_table 'DACV1')~}}
{{helper_common_initialize_ll_code @root.optim_enable @root.lut_table @root.current_resource~}}
/******************************************************************************/
/* Exported functions for {{@root.current_resource}} in {{@root.current_layer}} layer (SW instance {{@root.name}}) */
/******************************************************************************/
{{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer @root.current_index)~}}
{{assign 'current_index' (helper_common_inc_index @root.current_resource)~}}
{{!
    Generation of initialization function used in HAL
~}}
{{#with @root.dac_cxt}}
{{#if (eq @root.current_layer 'HAL')}}
hal_dac_handle_t *{{@root.fct_name~}}_init(void)
{
{{> RCC fct='generate_peripheral_clock_activation' hw_resource=@root.current_resource}}

{{> RCC fct='generate_kernel_clock' hw_resource=@root.current_resource sw_resource='DAC'}}

{{> DAC_HAL fct='init'}}

{{#with system}}
{{#with gpio}}
{{assign 'gpio_needs' 'undefined'~}}
{{#if channel1_gpio}}
{{assign 'gpio_needs' 'gpio_needed'~}}
{{/if}}
{{#if channel2_gpio}}
{{assign 'gpio_needs' 'gpio_needed'~}}
{{/if}}
{{#unless (eq @root.gpio_needs 'undefined')}}
  /****************************************************************************/
  /* Configuration of GPIO                                                    */
  /****************************************************************************/

{{> GPIO_HAL fct='init_resource' resource=@root.current_resource return_if_failed='NULL'}}
{{/unless}}{{! @root.gpio_needs}}
{{/with}}{{!gpio}}
{{~#with dma}}
{{#if dma_need_ch1}}
  /****************************************************************************/
  /* Configuration of DMA                                                     */
  /****************************************************************************/

  /* ========== Channel 1 ========== */
{{#> DMA_HAL fct='init' layer=@root.current_layer needs=dma_need_ch1.needs}}
{{/DMA_HAL}}
  HAL_DAC_SetChannelDMA(&h{{uppercase @root.current_resource}}, &h{{@root.dma_channel_instance}}, HAL_DAC_CHANNEL_1);
{{/if}}
{{#if dma_need_ch2}}
{{#if dma_need_ch1}}{{else}}
  /****************************************************************************/
  /* Configuration of DMA                                                     */
  /****************************************************************************/
{{/if}}

  /* ========== Channel 2 ========== */
{{#> DMA_HAL fct='init' layer=@root.current_layer needs=dma_need_ch2.needs}}
{{/DMA_HAL}}
  HAL_DAC_SetChannelDMA(&h{{uppercase @root.current_resource}}, &h{{@root.dma_channel_instance}}, HAL_DAC_CHANNEL_2);
{{/if}}
{{#if dma_need_dual}}
  /****************************************************************************/
  /* Configuration of DMA (Dual channel mode)                                 */
  /****************************************************************************/
{{#> DMA_HAL fct='init' layer=@root.current_layer needs=dma_need_dual.needs~}}
{{/DMA_HAL}}
  HAL_DAC_SetDualChannelDMA(&h{{uppercase @root.current_resource}}, &h{{@root.dma_channel_instance}}, HAL_DAC_CHANNEL_1);
{{/if}}
{{~/with~}}{{!dma}}
{{#with nvic}}
{{#if enable_interruption}}
  {{assign 'found_dac_interrupt' true~}}
  /* Enable the interruption for DAC */
{{assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context  @root.nvic_context nvic_config.needs @root.current_resource irq_handler_generation)~}}
{{#> CORTEX fct='init' layer=@root.current_layer needs=nvic_config.needs}}
#warning "Partial HAL CORTEX is not present"
{{/CORTEX}}

{{/if}}{{! enable_interruption~}}
{{~/with~}}{{!nvic}}
{{~/with~}}{{!system}}

  return &h{{@root.current_resource~}};
}

void {{@root.fct_name}}_deinit(void)
{
{{> DAC_HAL fct='deinit'}}

{{> RCC fct='generate_peripheral_clock_deactivation' hw_resource=@root.current_resource}}
{{> RCC fct='generate_peripheral_clock_reset' hw_resource=@root.current_resource}}
{{> RCC fct='kernel_clock_deinit' hw_resource=@root.current_resource}}
{{#with system}}
{{> GPIO_HAL fct='deinit_resource' resource=@root.current_resource}}
{{~#with dma}}
{{#if dma_need_ch1}}
{{#> DMA_HAL fct='deinit' layer=@root.current_layer needs=dma_need_ch1.needs}}
{{/DMA_HAL}}
{{/if}}
{{#if dma_need_ch2}}
{{#> DMA_HAL fct='deinit' layer=@root.current_layer needs=dma_need_ch2.needs}}
{{/DMA_HAL}}
{{/if}}
{{#if dma_need_dual}}
{{#> DMA_HAL fct='deinit' layer=@root.current_layer needs=dma_need_dual.needs~}}
{{/DMA_HAL}}
{{/if}}
{{~/with~}}{{!dma}}
{{~#with nvic}}
{{#if nvic_config_UDR}}
{{#> CORTEX fct='deinit' layer=@root.current_layer needs=nvic_config.needs~}}
{{/CORTEX~}}
{{/if}}
{{~/with~}}{{!nvic}}
{{~/with~}}{{!system}}
}

{{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer undefined)~}}
{{!
    Generation of getHandle functions used in HAL
~}}
hal_dac_handle_t *{{@root.fct_name~}}_gethandle(void)
{
  return &h{{@root.current_resource~}};
}

{{else}}{{! eq current_layer 'LL' ~}}

DAC_TypeDef *{{@root.fct_name}}_init(void)
{
{{> RCC fct='generate_peripheral_clock_activation' hw_resource=@root.current_resource}}

{{> RCC fct='generate_kernel_clock' hw_resource=@root.current_resource sw_resource='DAC'}}

{{> DAC_LL fct='init'}}

{{#with system}}
{{#with gpio}}
{{assign 'gpio_needs' 'undefined'~}}
{{#if channel1_gpio}}
{{assign 'gpio_needs' 'gpio_needed'~}}
{{/if}}
{{#if channel2_gpio}}
{{assign 'gpio_needs' 'gpio_needed'~}}
{{/if}}
{{#unless (eq @root.gpio_needs 'undefined')}}
  /****************************************************************************/
  /* Configuration of GPIO                                                    */
  /****************************************************************************/

{{> GPIO_LL fct='init_resource' resource=@root.current_resource}}
{{/unless}}{{! @root.gpio_needs}}
{{/with}}{{!gpio}}
{{~#with dma}}
{{#if dma_need_ch1}}
  /****************************************************************************/
  /* Configuration of DMA                                                     */
  /****************************************************************************/

  /* ========== Channel 1 ========== */
{{#> DMA_LL fct='init' layer=@root.current_layer needs=dma_need_ch1.needs}}
{{/DMA_LL}}
{{/if}}
{{#if dma_need_ch2}}
{{#if dma_need_ch1}}{{else}}
  /****************************************************************************/
  /* Configuration of DMA                                                     */
  /****************************************************************************/
{{/if}}

  /* ========== Channel 2 ========== */
{{#> DMA_LL fct='init' layer=@root.current_layer needs=dma_need_ch2.needs}}
{{/DMA_LL}}
{{/if}}
{{#if dma_need_dual}}
  /****************************************************************************/
  /* Configuration of DMA (Dual channel mode)                                 */
  /****************************************************************************/
{{#> DMA_LL fct='init' layer=@root.current_layer needs=dma_need_dual.needs~}}
{{/DMA_LL}}
{{/if}}
{{~/with~}}{{!dma}}
{{#with nvic}}
{{#if enable_interruption}}
  {{assign 'found_dac_interrupt' true~}}
  /* Enable the interruption for DAC */
{{assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context @root.nvic_context nvic_config.needs @root.current_resource irq_handler_generation)~}}
{{#> CORTEX fct='init' layer=@root.current_layer needs=nvic_config.needs}}
#warning "Partial LL CORTEX is not present"
{{/CORTEX}}
{{/if}}{{! enable_interruption~}}
{{~/with~}}{{!nvic}}

{{~/with~}}{{!system}}

  return {{@root.current_resource}};
}

void {{@root.fct_name}}_deinit(void)
{
{{> DAC_LL fct='deinit'}}

{{> RCC fct='generate_peripheral_clock_deactivation' hw_resource=@root.current_resource}}
{{> RCC fct='generate_peripheral_clock_reset' hw_resource=@root.current_resource}}
{{> RCC fct='kernel_clock_deinit' hw_resource=@root.current_resource}}
{{#with system}}
{{> GPIO_LL fct='deinit_resource' resource=@root.current_resource}}
{{~#with dma}}
{{#if dma_need_ch1}}
{{#> DMA_LL fct='deinit' layer=@root.current_layer needs=dma_need_ch1.needs}}
{{/DMA_LL}}
{{/if}}
{{#if dma_need_ch2}}
{{#> DMA_LL fct='deinit' layer=@root.current_layer needs=dma_need_ch2.needs}}
{{/DMA_LL}}
