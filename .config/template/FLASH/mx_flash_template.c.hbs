{
  if (HAL_FLASH_Init(&h{{@root.current_resource}}, HAL_{{uppercase @root.current_resource}}) != HAL_OK)
  {
   return NULL;
  }

      {{~#with additional}}
        {{~#if use_flash_programming}}


