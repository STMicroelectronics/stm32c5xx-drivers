{{#helper_common_beautifier}}
{{#if (eq @root.strategy "SW")}}
{{assign 'file_name' 'SMARTCARD'~}}
{{assign 'instances' (@root.SWConfigurationAPI.getInstances 'STMicroelectronics::Device:STM32CubeMX2 Config:SMARTCARD')~}}
{{else}}
{{#get_myctx~}}
{{#with _myctx~}}
{{!log "I2C template _myctx:" this~}}
{{assign 'current_resource' resource~}}
{{assign 'file_name' resource~}}
{{assign 'instances' instances~}}
{{/with~}}
{{/get_myctx~}}
{{/if}}
/**
  ******************************************************************************
  * @file           : mx_{{lowercase resource}}.h
  * @brief          : Header for mx_{{lowercase resource}}.c file.
{{> LICENSE}}

/* Define to prevent recursive inclusion -------------------------------------*/
#ifndef MX_{{resource}}_H
#define MX_{{resource}}_H

#ifdef __cplusplus
extern "C" {
#endif /* __cplusplus */

/* Includes ------------------------------------------------------------------*/
{{assign 'only_ll' true~}}
{{#each @root.instances}}
{{#if (eq @root.strategy "SW")}}
{{~assign 'smartcard_cxt' (@root.SWConfigurationAPI.getSwInstanceConfiguration this)~}}
{{~assign 'current_resource' (@root.peripheralsResourceManagerAPI.getPeripheralBoundToSoftwareInstance this)~}}
{{~assign 'current_layer' @root.smartcard_cxt.info.layer~}}
{{else}}
{{~assign 'current_layer' info.layer~}}
{{/if}}
{{#if (eq @root.current_layer 'HAL')}}
{{assign 'only_ll' false~}}
{{/if}}
{{/each}}
{{#if @root.only_ll}}
#include "stm32_ll.h"
{{else}}
#include "stm32_hal.h"
{{/if}}

/* Exported types ------------------------------------------------------------*/
/* Exported constants --------------------------------------------------------*/
{{#each @root.instances}}
{{#if (eq @root.strategy "SW")}}
{{~assign 'smartcard_cxt' (@root.SWConfigurationAPI.getSwInstanceConfiguration this)~}}
{{~assign 'current_resource' (@root.peripheralsResourceManagerAPI.getPeripheralBoundToSoftwareInstance this)~}}
{{~assign 'current_layer' @root.smartcard_cxt.info.layer~}}
{{else}}
{{~assign 'current_layer' info.layer~}}
{{/if}}
{{#if (eq @root.current_layer 'LL')}}
#define USE_{{uppercase @root.current_resource}}
{{/if}}
{{helper_gpio_generate_aliases @root.pinoutAPI @root.current_resource @root.current_layer~}}
{{/each}}

/* Exported macros -----------------------------------------------------------*/
/* Exported variables --------------------------------------------------------*/
/* Exported functions ------------------------------------------------------- */

{{assign 'current_index' 0~}}
{{#each instances}}
{{#if (eq @root.strategy "SW")}}
{{assign 'smartcard_cxt' (@root.SWConfigurationAPI.getSwInstanceConfiguration this)~}}
{{assign 'current_resource' (@root.peripheralsResourceManagerAPI.getPeripheralBoundToSoftwareInstance this)~}}
{{assign 'current_layer' @root.smartcard_cxt.info.layer~}}
{{else}}
{{assign 'current_layer' info.layer~}}
{{/if}}
{{assign 'current_function' 'SMARTCARD'~}}
/******************************************************************************/
/* Exported functions for {{@root.current_function}} in {{@root.current_layer}} layer */
/******************************************************************************/
{{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer @root.current_index @root.current_function @root.from_where)~}}
/**
  * @brief {{@root.fct_name}} init function
  * This function configures the hardware resources used in this example
  * @retval pointer to handle or NULL in case of failure
  */
{{#if (eq @root.current_layer 'HAL')}}
hal_smartcard_handle_t *{{@root.fct_name}}_init(void);
{{else}}
USART_TypeDef *{{@root.fct_name}}_init(void);
{{/if}}

/**
  * @brief  De-initialize {{@root.fct_name}} instance and return it.
  * @retval None
  */
void {{@root.fct_name}}_deinit(void);

{{#if (eq @root.current_layer 'HAL')}}
{{> SMARTCARD_HAL fct='exported_functions_gethandle_prototype'}}
{{else}}
{{> DMA_LL fct='get_dma_lli_reg' resource=@root.dma_resource strategy=@root.strategy type='prototype'}}
{{/if}}

{{/each}}
{{> CORTEX fct='generate_irqhandler' type='prototype' component='SMARTCARD'}}
#ifdef __cplusplus
}
#endif /* __cplusplus */

#endif /* MX_{{resource}}_H */
{{/helper_common_beautifier}}
