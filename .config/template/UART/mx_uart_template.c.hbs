{{#helper_common_beautifier}}
{{assign "strategy" (@root.SWProjectAPI.getSelectedGenerationStrategy)~}}
{{log "strategy" @root.strategy~}}
{{#if (eq @root.strategy "SW")}}
{{assign 'current_resource' 'UART'~}}
{{assign 'instances' (@root.SWConfigurationAPI.getInstances 'STMicroelectronics::Device:STM32CubeMX2 Config:UART')~}}
{{assign 'dma_resource' 'STM32CubeMX2 Config:UART'~}}
{{else}}
{{assign "strategy" 'HW'~}}
{{#get_myctx~}}
{{#with _myctx~}}
{{!log "UART template _myctx:" this~}}
{{assign 'current_resource' resource~}}
{{assign 'dma_resource' resource~}}
{{assign 'instances' instances~}}
{{/with~}}
{{/get_myctx~}}
{{/if}}
{{!log "UART template _myctx:" this~}}
{{log "UART template current_resource:" @root.current_resource~}}
{{> SYSTEM fct='system_check_ll_optim'}}
/**
  ******************************************************************************
  * @file           : mx_{{lowercase @root.current_resource}}.c
  * @brief          : {{@root.current_resource}} Peripheral initialization
{{> LICENSE}}

/* Includes ------------------------------------------------------------------*/
#include "mx_{{lowercase @root.current_resource}}.h"
{{> RCC fct='include_rcc'}}

/* Private typedef -----------------------------------------------------------*/
/* Private define ------------------------------------------------------------*/
/* Private macro -------------------------------------------------------------*/
/* Private variables ---------------------------------------------------------*/
/* Private functions prototype------------------------------------------------*/
/* Exported variables by reference--------------------------------------------*/
{{!
    Generation of handle for each function defined in HAL layer
    - save a variable to indicate if handle has been already created (only 1 handle by function)
~}}
{{~#each instances~}}
{{#if (eq @root.strategy "SW")}}
{{assign 'uart_cxt' (@root.SWConfigurationAPI.getSwInstanceConfiguration this)~}}
{{log "UART template uart_cxt:" (toJSON @root.uart_cxt)~}}
{{assign 'current_resource' (@root.peripheralsResourceManagerAPI.getPeripheralBoundToSoftwareInstance this)~}}
{{assign 'current_layer' @root.uart_cxt.info.layer~}}
{{log "UART template current_resource:" @root.current_resource~}}
{{else}}
{{assign 'current_function' info.function_type~}}
{{assign 'current_layer' info.layer~}}
{{/if}}

{{#if (eq @root.current_layer 'HAL')}}
{{> UART_HAL fct='exported_variables'}}
{{else}}
{{> UART_LL fct='exported_variables'}}
{{/if}}
{{/each}}

/* Exported function definition ----------------------------------------------*/
{{assign 'current_index' 0~}}
{{#each instances}}
{{#if (eq @root.strategy "SW")}}
{{assign 'uart_cxt' (@root.SWConfigurationAPI.getSwInstanceConfiguration this)~}}
{{assign 'current_resource' (@root.peripheralsResourceManagerAPI.getPeripheralBoundToSoftwareInstance this)~}}
{{assign 'current_layer' @root.uart_cxt.info.layer~}}
{{assign 'current_function' @root.uart_cxt.info.function_type~}}
{{assign 'context' @root.uart_cxt~}}

{{else}}
{{assign 'context' this~}}
{{assign 'current_function' info.function_type~}}
{{assign 'current_layer' info.layer~}}
{{/if}}

{{assign 'lut_table'   (helper_uart_get_lut_table 'V3')~}}
{{helper_common_initialize_ll_code @root.optim_enable @root.lut_table @root.current_resource~}}
{{assign 'nvic_context' 'undefined'~}}
/******************************************************************************/
/* Exported functions for {{@root.current_function}} in {{@root.current_layer}} layer */
/******************************************************************************/

{{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer @root.current_index @root.current_function @root.from_where)~}}
{{#with @root.context}}
{{!
    Generation of initialization function used in HAL
~}}
{{#if (eq @root.current_layer 'HAL')}}
{{!
    Generation of initialization function used in HAL using USART component
~}}
{{> UART_HAL fct='exported_functions_init'}}
{{else}}
{{!
    Generation of initialization function used in LL
~}}
{{> UART_LL fct='exported_functions_init'}}
{{/if}}
{{#if (eq @root.current_layer 'HAL')}}
{{!
    Generation of getHandle functions used in HAL
    - should be generate only 1 time by function
}}
{{> UART_HAL fct='exported_functions_gethandle'}}
{{/if}}
{{/with}}
{{/each}}
{{> CORTEX fct='generate_irqhandler' type='implementation' component='UART'}}
{{/helper_common_beautifier}}
