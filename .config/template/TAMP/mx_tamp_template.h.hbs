{{#helper_common_beautifier}}
{{#if (eq @root.strategy "SW")}}
  {{~assign 'file_name' 'TAMP'~}}
  {{~assign 'instances' (@root.SWConfigurationAPI.getInstances 'STMicroelectronics::Device:STM32CubeMX2 Config:TAMP')~}}
{{else}}
  {{#get_myctx~}}
    {{#with _myctx~}}
      {{~assign 'current_resource' resource~}}
      {{~assign 'file_name' resource~}}
      {{~assign 'instances' instances~}}
    {{/with~}}
    {{/get_myctx~}}
{{/if}}
/**
  ******************************************************************************
  * @file           : mx_{{lowercase @root.file_name}}.h
  * @brief          : Header for mx_{{lowercase @root.file_name}}.c file.
{{> LICENSE}}


/* Define to prevent recursive inclusion -------------------------------------*/
#ifndef MX_{{@root.file_name}}_H
#define MX_{{@root.file_name}}_H

#ifdef __cplusplus
extern "C" {
#endif /* __cplusplus */

/* Includes ------------------------------------------------------------------*/
{{assign 'only_ll' true~}}
{{#each @root.instances~}}
{{#if (eq @root.strategy "HW")}}
{{assign 'current_layer' info.layer~}}
{{else}}
{{assign 'tamp_cxt' (@root.SWConfigurationAPI.getInstanceConfiguration this)~}}
{{assign 'current_resource' @root.tamp_cxt.settings.resources.id~}}
{{assign 'current_layer' @root.tamp_cxt.settings.parameters.info.layer~}}
{{/if}}
{{#if (eq @root.current_layer 'HAL')}}
{{assign 'only_ll' false~}}
{{/if}}
{{/each}}
{{#if @root.only_ll}}
#include "stm32_ll.h"
#include "mx_def.h"
{{else}}
#include "stm32_hal.h"
#include "mx_def.h"
{{/if}}

/* Exported types ------------------------------------------------------------*/
/* Exported constants --------------------------------------------------------*/
{{#each @root.instances}}
  {{!log "GPIO template - instance:" (toJSON this)~}}
  {{#if (eq @root.strategy "HW")}}
    {{! ~}}
    {{assign 'current_layer' info.layer~}}
    {{assign 'name' name~}}
  {{else}}
    {{! ~}}
    {{~assign 'tamp_cxt' (@root.SWConfigurationAPI.getSwInstanceConfiguration this)~}}
    {{~assign 'current_layer' @root.tamp_cxt.info.layer~}}
    {{~assign 'current_resource' (@root.peripheralsResourceManagerAPI.getPeripheralBoundToSoftwareInstance this)~}}
    {{assign 'name' @root.tamp_cxt.name~}}
  {{/if}}
  {{#if (eq @root.current_layer 'LL')}}
#define USE_{{uppercase @root.current_resource}}
  {{/if}}
{{helper_gpio_generate_aliases @root.pinoutAPI @root.current_resource @root.current_layer~}}

/******************************************************************************/
/* Exported defines for {{@root.current_resource}} in {{@root.current_layer}} layer (SW instance {{@root.name}}) */
/******************************************************************************/
{{#with basic}}
{{#with tamper_indiv_config}}
{{#each tampers}}
{{#if use_channel}}
{{#if tamper_label_name}}
{{#if (eq @root.current_layer 'HAL')}}
{{@root._define_}} {{tamper_label_name}} HAL_TAMP_{{_foreignKey}}
{{else}}
{{@root._define_}} {{tamper_label_name}} LL_{{helper_tamp_convert _foreignKey}}
{{/if}}
{{/if}}{{!tamper_label_name~}}
{{/if}}{{!use_channel~}}
{{/each}}
{{#each internal_tampers}}
{{#if use_channel}}
{{#if int_tamper_label_name}}
{{#if (eq @root.current_layer 'HAL')}}
{{@root._define_}} {{int_tamper_label_name}} HAL_TAMP_{{_foreignKey}}
{{else}}
{{@root._define_}} {{int_tamper_label_name}} LL_{{helper_tamp_internal_convert _foreignKey}}
{{/if}}
{{/if}}{{!int_tamper_label_name~}}
{{/if}}{{!use_channel~}}
{{/each}}
{{/with}}{{!tamper_indiv_config~}}
{{/with}}{{!basic~}}
{{/each}}
/* Exported macros -----------------------------------------------------------*/
/* Exported variables --------------------------------------------------------*/
/* Exported functions ------------------------------------------------------- */
{{assign 'current_index' 0~}}
{{#each @root.instances}}
  {{#if (eq @root.strategy "SW")}}
    {{~assign 'tamp_cxt' (@root.SWConfigurationAPI.getSwInstanceConfiguration this)~}}
    {{~assign 'current_resource' (@root.peripheralsResourceManagerAPI.getPeripheralBoundToSoftwareInstance this)~}}
    {{~assign 'current_layer' @root.tamp_cxt.info.layer~}}
    {{~assign 'current_index' (helper_common_get_index @root.current_resource)~}}
  {{else}}
    {{~assign 'current_layer' info.layer~}}
  {{/if}}
/******************************************************************************/
/* Exported functions for TAMP in {{@root.current_layer}} layer */
/******************************************************************************/
{{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer @root.current_index)~}}
{{assign 'current_index' (helper_common_inc_index @root.current_resource)~}}
/**
  * @brief {{@root.fct_name}} init function
  * This function configures the hardware resources used in this example
  * @retval pointer to handle or NULL in case of failure
  */
system_status_t {{@root.fct_name}}_init(void);

/**
  * @brief  De-initialize {{lowercase @root.current_resource}} instance and return it.
  */
void {{@root.fct_name}}_deinit(void);

{{/each}}

{{#each @root.irq_info_list}}
{{#if generate_handler}}
/******************************************************************************/
/*                     {{description}}                    */
/******************************************************************************/
void {{line}}_IRQHandler(void);

{{else}}
/******************************************************************************/
/*    {{description}} is managed directly in user code.   */
/******************************************************************************/
/* void {{line}}_IRQHandler(void); */

{{/if}}
