{{#helper_common_beautifier}}
{{assign '_define_' '#define'~}}
{{#if (eq @root.strategy "SW")}}
  {{~assign 'file_name' 'ETH'~}}
  {{~assign 'instances' (@root.SWConfigurationAPI.getInstances 'STMicroelectronics::Device:STM32CubeMX2 Config:ETH')~}}
{{else}}
  {{#get_myctx~}}
    {{#with _myctx~}}
      {{~assign 'current_resource' resource~}}
      {{~assign 'file_name' resource~}}
      {{~assign 'instances' instances~}}
    {{/with~}}
  {{/get_myctx~}}
{{/if}}
/**
  ******************************************************************************
  * @file           : mx_{{lowercase @root.file_name}}.h
  * @brief          : Header for mx_{{lowercase @root.file_name}}.c file.
{{> LICENSE}}


/* Define to prevent recursive inclusion -------------------------------------*/
#ifndef MX_{{@root.file_name}}_H
#define MX_{{@root.file_name}}_H

#ifdef __cplusplus
extern "C" {
#endif /* __cplusplus */

/* Includes ------------------------------------------------------------------*/
#include "stm32_{{lowercase @root.current_layer}}.h"
#include "mx_def.h"

/* Exported types ------------------------------------------------------------*/
/* Exported constants --------------------------------------------------------*/
{{#each @root.instances}}
  {{#if (eq @root.strategy "SW")}}
    {{~assign 'current_resource' (@root.peripheralsResourceManagerAPI.getPeripheralBoundToSoftwareInstance this)~}}
    {{~assign 'eth_cxt' (@root.SWConfigurationAPI.getSwInstanceConfiguration this)~}}
    {{~assign 'current_layer' @root.eth_cxt.info.layer~}}
  {{else}}
    {{~assign 'current_layer' info.layer~}}
  {{/if}}
{{assign 'tx_desc_labels' 0}}
{{#each eth_tx_channels as |channel|}}
{{#if channel.use_channel}}
  {{#with @index as |channel_index|}}
    {{#each channel.labels as |label|}}
      {{#if (length label)}}
        {{#if (eq @root.tx_desc_labels 0)}}
          {{~assign 'tx_desc_labels' 1}}
/* Aliases of TX Channels labels */
        {{/if}}
          {{#if (eq @root.current_layer 'HAL')}}
{{@root._define_}} {{uppercase label}}_CH_ID                            HAL_ETH_TX_CHANNEL_{{channel_index}}
{{@root._define_}} {{uppercase label}}_CH_MAX_APP_BUFF_NUM              {{channel.basic.max_app_buffers_num}}UL
            {{#if channel.basic.req_desc_size_align_byte}}
{{@root._define_}} {{uppercase label}}_CH_DESC_ALIGN_SZ_BYTE            {{channel.basic.req_desc_size_align_byte}}UL
            {{else}}
{{@root._define_}} {{uppercase label}}_CH_DESC_ALIGN_SZ_BYTE            24UL
            {{/if}}
          {{/if}}
      {{/if}}
    {{/each}}
  {{/with}}
{{/if}}
{{/each}}{{!eth_tx_channels}}

{{assign 'rx_desc_labels' 0}}
{{#each eth_rx_channels as |channel|}}
{{#if channel.use_channel}}
  {{#with @index as |channel_index|}}
    {{#each channel.labels as |label|}}
      {{#if (length label)}}
        {{#if (eq @root.rx_desc_labels 0)}}
          {{~assign 'rx_desc_labels' 1}}
/* Aliases of RX Channels labels */
        {{/if}}
          {{#if (eq @root.current_layer 'HAL')}}
{{@root._define_}} {{uppercase label}}_CH_ID                            HAL_ETH_RX_CHANNEL_{{channel_index}}
{{@root._define_}} {{uppercase label}}_CH_MAX_APP_BUFF_NUM              {{channel.basic.max_app_buffers_num}}UL
            {{#if channel.basic.req_desc_size_align_byte}}
{{@root._define_}} {{uppercase label}}_CH_DESC_ALIGN_SZ_BYTE            {{channel.basic.req_desc_size_align_byte}}UL
            {{else}}
{{@root._define_}} {{uppercase label}}_CH_DESC_ALIGN_SZ_BYTE            24UL
            {{/if}}
{{@root._define_}} {{uppercase label}}_CH_RX_BUFFER_LEN_BYTE            {{channel.basic.rx_buffer_len_byte}}UL
          {{/if}}
      {{/if}}
    {{/each}}
  {{/with}}
{{/if}}
{{/each}}{{!eth_tx_channels}}

{{helper_gpio_generate_aliases @root.pinoutAPI @root.current_resource @root.current_layer}}
{{/each}}

/* Exported macros -----------------------------------------------------------*/
/* Exported variables --------------------------------------------------------*/
/* Exported functions ------------------------------------------------------- */
{{helper_common_initialize_index~}}
{{assign 'current_index' (helper_common_get_index @root.current_resource)~}}
{{#each @root.instances}}
  {{#if (eq @root.strategy "SW")}}
    {{~assign 'eth_cxt' (@root.SWConfigurationAPI.getSwInstanceConfiguration this)~}}
    {{~assign 'current_resource' (@root.peripheralsResourceManagerAPI.getPeripheralBoundToSoftwareInstance this)~}}
    {{~assign 'current_layer' @root.eth_cxt.info.layer~}}
    {{~assign 'current_index' (helper_common_get_index @root.current_resource)~}}
  {{else}}
    {{~assign 'current_layer' info.layer~}}
  {{/if}}
/******************************************************************************/
/* Exported functions for ETH in {{@root.current_layer}} layer */
/******************************************************************************/
{{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer @root.current_index @root.current_function @root.from_where)~}}
{{assign 'current_index' (helper_common_inc_index @root.current_resource)~}}
/**
  * @brief {{@root.fct_name}} init function
  * This function configures the hardware resources used in this example
  * @retval pointer to handle or NULL in case of failure
  */
{{#if (eq @root.current_layer 'HAL')}}
hal_eth_handle_t *{{@root.fct_name}}_init(void);
{{/if}}

/**
  * @brief  De-initialize {{lowercase @root.current_resource}} instance and return it.
  */
void {{@root.fct_name}}_deinit(void);

{{#if (eq @root.current_layer 'HAL')}}
{{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer undefined )~}}
/**
  * @brief  Get the {{@root.current_resource}} object.
  * @retval Pointer on the {{@root.current_resource}} Handle
  */
hal_eth_handle_t *{{@root.fct_name}}_gethandle(void);
{{/if}}
{{/each}}

{{#if (not (eq @root.eth_exti_needs 'undefined'))}}
/******************************************************************************/
/* EXTI get handle.                                                           */
/******************************************************************************/
{{#> EXTI fct='exti_gethandle_proto' needs=@root.eth_exti_needs~}}
{{/EXTI}}
{{/if}}

{{> CORTEX fct='generate_irqhandler' type='prototype' component='ETH'}}

#ifdef __cplusplus
}
#endif /* __cplusplus */

#endif /* MX_{{@root.file_name}}_H */
{{/helper_common_beautifier}}
