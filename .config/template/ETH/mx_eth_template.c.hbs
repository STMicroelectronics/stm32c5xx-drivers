hal_eth_handle_t *{{@root.fct_name}}_init(void)
{
  /* Ethernet config */
  hal_eth_config_t eth_config;
  /* Ethernet MAC config */
  hal_eth_mac_config_t eth_mac_config;
{{#if @root.use_tx_channels}}
  /* Ethernet DMA-Tx Channel Config */
  hal_eth_tx_channel_config_t eth_tx_channel_config;
{{/if}}
{{#if @root.use_rx_channels}}
  /* Ethernet DMA-Rx Channel Config */
  hal_eth_rx_channel_config_t eth_rx_channel_config;
{{/if}}

  /****************************************************************************/
  /* Configuration of Clocks                                                  */
  /****************************************************************************/
{{> RCC fct='generate_peripheral_clock_activation' hw_resource=@root.current_resource}}

{{> RCC fct='generate_kernel_clock' hw_resource=@root.current_resource sw_resource='ETH'}}

{{#with system.gpio~}}
{{assign 'gpio_needs' 'undefined'~}}
{{! Concatenate all the gpio config inside the same variable and use finally this variable in the partial GPIO ~}}
{{#if gpio_eth.needs}}
{{assign 'found_spi_gpio_eth' true~}}
{{assign 'gpio_needs' (helper_common_concatenate_needs gpio_eth.needs @root.gpio_needs)~}}
{{/if}}
{{#if gpio_rmii.needs}}
{{assign 'found_spi_gpio_rmii' true~}}
{{assign 'gpio_needs' (helper_common_concatenate_needs gpio_rmii.needs @root.gpio_needs)~}}
{{/if}}
{{#if gpio_mii.needs}}
{{assign 'found_spi_gpio_mii' true~}}
{{assign 'gpio_needs' (helper_common_concatenate_needs gpio_mii.needs @root.gpio_needs)~}}
{{/if}}
{{#if gpio_phy_intn.needs}}
{{assign 'found_spi_gpio_phy_intn' true~}}
{{assign 'gpio_needs' (helper_common_concatenate_needs gpio_phy_intn.needs @root.gpio_needs)~}}
{{/if}}
  /****************************************************************************/
  /* Configuration of GPIO                                                    */
  /****************************************************************************/
{{#> GPIO_HAL fct='init_resource' resource=@root.current_resource return_if_failed='NULL'}}
#warning "Partial GPIO is not present"
{{/GPIO_HAL~}}
{{/with}}  {{! system.gpio ~}}

  if (HAL_ETH_Init(&h{{@root.current_resource}}, HAL_{{uppercase @root.current_resource}}) != HAL_OK)
  {
    return NULL;
  }

  /* Set the MAC Address */
  {{@root.fct_name}}_set_mac_address(&eth_config.mac_addr[0]);

{{#with basic}}
  /* Set the Media Interface type */
  eth_config.media_interface = {{media_interface~}};
{{/with}}{{! basic }}

  /*
   * Call the Ethernet HAL API HAL_ETH_SetConfig() to set Peripheral's
   * User Configuration.
   */
  if(HAL_ETH_SetConfig(&h{{@root.current_resource}}, &eth_config) != HAL_OK)
  {
    HAL_ETH_DeInit(&h{{@root.current_resource}});
    return NULL;
  }

  /*
   * Call the Ethernet HAL API HAL_ETH_MAC_GetConfig() to get the default
   * Peripheral's MAC Configuration.
   */
  HAL_ETH_MAC_GetConfig(&h{{@root.current_resource}}, &eth_mac_config);

{{#with basic.eth_mac_config}}
  /* Set the Ethernet MAC Link Configuration */
  eth_mac_config.link_config.speed        = {{speed~}};
  eth_mac_config.link_config.duplex_mode  = {{duplex_mode~}};
  /* Set the Ethernet MAC Loopback Mode */
{{#if loopback_mode}}
  eth_mac_config.loopback_mode            = HAL_ETH_MAC_LOOPBACK_ENABLE;
{{else}}
  eth_mac_config.loopback_mode            = HAL_ETH_MAC_LOOPBACK_DISABLE;
{{/if}}
{{/with}}{{! basic.eth_mac_config }}

  /*
   * Call the Ethernet HAL API HAL_ETH_MAC_SetConfig() to set the Peripheral's
   * MAC Configuration.
   */
  if(HAL_ETH_MAC_SetConfig(&h{{@root.current_resource}}, &eth_mac_config) != HAL_OK)
  {
    HAL_ETH_DeInit(&h{{@root.current_resource}});
    return NULL;
  }

{{#each eth_tx_channels}}
{{#if use_channel}}
  /*
   * Call the Ethernet HAL API HAL_ETH_GetConfigTxChannel() to get the default
   * configuration for the Tx Channel {{_foreignKey}}.
   */
  HAL_ETH_GetConfigTxChannel(&h{{@root.current_resource}}, HAL_ETH_TX_CHANNEL_{{_foreignKey}},
                             &eth_tx_channel_config);

  /* Set the Tx Channel {{_foreignKey}} Configuration */
{{#with basic}}
  eth_tx_channel_config.max_app_buffers_num                         = {{max_app_buffers_num}}UL;
{{#if req_desc_size_align_byte}}
  eth_tx_channel_config.req_desc_size_align_byte                    = {{req_desc_size_align_byte}}UL;
{{else}}
  eth_tx_channel_config.req_desc_size_align_byte                    = 1UL;
{{/if}}
  eth_tx_channel_config.fifo_event_config.event_mode                = {{event_mode}};
{{#if event_params}}
  eth_tx_channel_config.fifo_event_config.event_params              = {{event_params}}UL;
{{/if}}
{{/with}}{{! basic ~}}
{{#with additional}}
  eth_tx_channel_config.dma_channel_config.tx_dma_burst_length      = {{dma_channel_config.tx_dma_burst_length}};
{{#if dma_channel_config.tx_pbl_x8_mode}}
  eth_tx_channel_config.dma_channel_config.tx_pbl_x8_mode           = HAL_ETH_DMA_TX_PBL_X8_ENABLE;
{{else}}
  eth_tx_channel_config.dma_channel_config.tx_pbl_x8_mode           = HAL_ETH_DMA_TX_PBL_X8_DISABLE;
{{/if}}
{{#if dma_channel_config.tx_second_pkt_operate}}
  eth_tx_channel_config.dma_channel_config.tx_second_pkt_operate    = HAL_ETH_DMA_TX_SEC_PKT_OP_ENABLE;
{{else}}
  eth_tx_channel_config.dma_channel_config.tx_second_pkt_operate    = HAL_ETH_DMA_TX_SEC_PKT_OP_DISABLE;
{{/if}}
  eth_tx_channel_config.mtl_queue_config.queue_size_byte            = {{mtl_queue_config.queue_size_byte}};
  eth_tx_channel_config.mtl_queue_config.transmit_queue_mode        = {{mtl_queue_config.transmit_queue_mode}};
{{#if mtl_queue_config.enable_av_mode}}
  eth_tx_channel_config.mtl_queue_config.queue_op_mode              = HAL_ETH_MTL_TX_QUEUE_AV_ENABLED;
{{else}}
  eth_tx_channel_config.mtl_queue_config.queue_op_mode              = HAL_ETH_MTL_TX_QUEUE_ENABLED;
{{/if}}
{{/with}}{{! additional }}

  /*
   * Call the Ethernet HAL API HAL_ETH_SetConfigTxChannel() to set the
   * Tx channel {{_foreignKey}} Configuration.
   */
  if(HAL_ETH_SetConfigTxChannel(&h{{@root.current_resource}}, HAL_ETH_TX_CHANNEL_{{_foreignKey}},
                                &eth_tx_channel_config) != HAL_OK)
  {
    HAL_ETH_DeInit(&h{{@root.current_resource}});
    return NULL;
  }

{{/if}}
{{/each}}{{! eth_tx_channels ~}}
{{#each eth_rx_channels}}
{{#if use_channel}}
  /*
   * Call the Ethernet HAL API HAL_ETH_GetConfigRxChannel() to get the default
   * configuration for the Rx channel {{_foreignKey}}.
   */
  HAL_ETH_GetConfigRxChannel(&h{{@root.current_resource}}, HAL_ETH_RX_CHANNEL_{{_foreignKey}},
                             &eth_rx_channel_config);

  /* Set the Rx Channel {{_foreignKey}} Configuration */
{{#with basic}}
  eth_rx_channel_config.dma_channel_config.rx_buffer_len_byte       = {{rx_buffer_len_byte}}UL;
  eth_rx_channel_config.max_app_buffers_num                         = {{max_app_buffers_num}}UL;
{{#if req_desc_size_align_byte}}
  eth_rx_channel_config.req_desc_size_align_byte                    = {{req_desc_size_align_byte}}UL;
{{else}}
  eth_rx_channel_config.req_desc_size_align_byte                    = 1UL;
{{/if}}
  eth_rx_channel_config.fifo_event_config.event_mode                = {{event_mode}};
{{#if event_params}}
  eth_rx_channel_config.fifo_event_config.event_params              = {{event_params}}UL;
{{/if}}
{{/with}}{{! basic ~}}
{{#with additional}}
  eth_rx_channel_config.dma_channel_config.rx_dma_burst_length      = {{dma_channel_config.rx_dma_burst_length}};
  eth_rx_channel_config.mtl_queue_config.queue_size_byte            = {{mtl_queue_config.queue_size_byte}};
  eth_rx_channel_config.mtl_queue_config.receive_queue_mode         = {{mtl_queue_config.receive_queue_mode}};
{{#if mtl_queue_config.enable_av_mode}}
  eth_rx_channel_config.mtl_queue_config.queue_op_mode              = HAL_ETH_MTL_RX_QUEUE_AV_ENABLED;
{{else}}
  eth_rx_channel_config.mtl_queue_config.queue_op_mode              = HAL_ETH_MTL_RX_QUEUE_ENABLED;
{{/if}}
{{#if mtl_queue_config.drop_tcp_ip_csum_error_pkt}}
  eth_rx_channel_config.mtl_queue_config.drop_tcp_ip_csum_error_pkt = HAL_ETH_MTL_RX_DROP_CS_ERR_ENABLE;
{{else}}
  eth_rx_channel_config.mtl_queue_config.drop_tcp_ip_csum_error_pkt = HAL_ETH_MTL_RX_DROP_CS_ERR_DISABLE;
{{/if}}
{{#if mtl_queue_config.fwd_error_pkt}}
  eth_rx_channel_config.mtl_queue_config.fwd_error_pkt              = HAL_ETH_MTL_RX_FWD_ERR_PKT_ENABLE;
{{else}}
  eth_rx_channel_config.mtl_queue_config.fwd_error_pkt              = HAL_ETH_MTL_RX_FWD_ERR_PKT_DISABLE;
{{/if}}
{{#if mtl_queue_config.fwd_undersized_good_pkt}}
  eth_rx_channel_config.mtl_queue_config.fwd_undersized_good_pkt    = HAL_ETH_MTL_RX_FWD_USZ_PKT_ENABLE;
{{else}}
  eth_rx_channel_config.mtl_queue_config.fwd_undersized_good_pkt    = HAL_ETH_MTL_RX_FWD_USZ_PKT_DISABLE;
{{/if}}
{{/with}}{{! additional }}

  /*
   * Call the Ethernet HAL API HAL_ETH_SetConfigRxChannel() to set the
   * Rx channel {{_foreignKey}} Configuration.
   */
  if(HAL_ETH_SetConfigRxChannel(&h{{@root.current_resource}}, HAL_ETH_RX_CHANNEL_{{_foreignKey}},
                                &eth_rx_channel_config) != HAL_OK)
  {
    HAL_ETH_DeInit(&h{{@root.current_resource}});
    return NULL;
  }

{{/if}}
{{/each}}{{! eth_rx_channels ~}}

{{#with additional~}}
{{/with}}{{! additional ~}}

{{#with system~}}
{{#with nvic~}}
{{#if enable_global_interrupt~}}
{{assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context @root.nvic_context nvic_config_global.needs @root.current_resource irq_handler_generation_global)}}
  /****************************************************************************/
  /* Configuration of NVIC                                                    */
  /****************************************************************************/
{{#> CORTEX fct='init' layer=@root.current_layer needs=nvic_config_global.needs}}
#warning "Partial CORTEX is not present"
{{/CORTEX~}}
{{/if}}
{{/with}}{{! nvic }}

{{#if (not (eq @root.eth_exti_needs 'undefined'))}}
  /****************************************************************************/
  /* Configuration of EXTI                                                    */
  /****************************************************************************/
  {{#> EXTI fct='exti_get_init' layer=@root.current_layer needs=@root.eth_exti_needs found_exti=@root.found_exti~}}
  {{/EXTI}}
  {{~assign 'found_exti' true~}}
{{/if}}
{{/with}}  {{! system }}

  return &h{{@root.current_resource}};
}

void {{@root.fct_name}}_deinit(void)
{
{{#with system.nvic~}}
{{#if enable_global_interrupt}}
  /* Disable the ETH Global interrupt */
{{#> CORTEX fct='deinit' layer=@root.current_layer needs=nvic_config_global.needs}}
#warning "Partial CORTEX is not present"
{{/CORTEX~}}
{{/if}}
{{/with}}  {{! system.nvic }}

{{#if (not (eq @root.eth_exti_needs 'undefined'))}}
  {{#> EXTI fct='exti_get_deinit' layer=@root.current_layer needs=@root.eth_exti_needs}}
  {{/EXTI}}
{{/if}}

  /* Deinitialize the ETH peripheral */
  (void)HAL_ETH_DeInit(&h{{@root.current_resource}});

