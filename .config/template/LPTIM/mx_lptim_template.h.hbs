{{#helper_common_beautifier}}
{{#if (eq @root.strategy "SW")}}
  {{~assign 'file_name' 'LPTIM'~}}
  {{~assign 'instances' (@root.SWConfigurationAPI.getInstances 'STMicroelectronics::Device:STM32CubeMX2 Config:LPTIM')~}}
{{else}}
  {{#get_myctx~}}
    {{#with _myctx~}}
      {{~assign 'current_resource' resource~}}
      {{~assign 'file_name' resource~}}
      {{~assign 'instances' instances~}}
    {{/with~}}
    {{/get_myctx~}}
{{/if}}
/**
  ******************************************************************************
  * @file           : mx_{{lowercase @root.file_name}}.h
  * @brief          : Header for mx_{{lowercase @root.file_name}}.c file.
{{> LICENSE}}


/* Define to prevent recursive inclusion -------------------------------------*/
#ifndef MX_{{@root.current_resource}}_H
#define MX_{{@root.current_resource}}_H

#ifdef __cplusplus
extern "C" {
#endif /* __cplusplus */

/* Includes ------------------------------------------------------------------*/
{{assign 'only_ll' true~}}
{{assign "_define_" "#define"~}}
{{#each @root.instances~}}
{{#if (eq @root.strategy "HW")}}
{{assign 'current_layer' info.layer~}}
{{else}}
{{assign 'lptim_cxt' (@root.SWConfigurationAPI.getInstanceConfiguration this)~}}
{{assign 'current_resource' (@root.peripheralsResourceManagerAPI.getPeripheralBoundToSoftwareInstance this)~}}
{{assign 'current_layer' @root.lptim_cxt.settings.parameters.info.layer~}}
{{/if}}
{{#if (eq @root.current_layer 'HAL')}}
{{assign 'only_ll' false~}}
{{/if}}
{{/each}}
{{#if @root.only_ll}}
#include "stm32_ll.h"
{{else}}
#include "stm32_hal.h"
{{/if}}

/* Exported types ------------------------------------------------------------*/
/* Exported constants --------------------------------------------------------*/
{{#each @root.instances}}
  {{#if (eq @root.strategy "SW")}}
    {{~assign 'lptim_ctx' (@root.SWConfigurationAPI.getSwInstanceConfiguration this)~}}
    {{~assign 'current_resource' (@root.peripheralsResourceManagerAPI.getPeripheralBoundToSoftwareInstance this)~}}
    {{~assign 'current_layer' @root.lptim_ctx.info.layer~}}
  {{else}}
    {{~assign 'current_layer' info.layer~}}
  {{/if}}
  {{#if (eq @root.current_layer 'LL')}}
#define USE_{{uppercase @root.current_resource}}
  {{/if}}

{{assign 'desc_labels' 0~}}
{{#each channels as |channel|}}
{{assign 'channel_id' (helper_lptim_get_channel_id _foreignKey)~}}
{{#with output_configuration}}
{{#each labels}}
{{#if (length this)}}
{{#if (eq @root.desc_labels 0)}}
{{assign 'desc_labels' 1~}}
/* Aliases of channels labels */
{{/if}}{{!desc_labels~}}
{{#if (eq @root.current_layer 'HAL')}}
{{@root._define_}} {{uppercase this}}_CHANNEL  HAL_LPTIM_CHANNEL_{{@root.channel_id}}
{{else}}
{{@root._define_}} {{uppercase this}}_CHANNEL  LL_LPTIM_CHANNEL_CH{{@root.channel_id}}
{{/if}}{{!HAL~}}
{{/if}}{{!length~}}
{{/each}}{{!labels~}}
{{/with}}{{!output_configuration~}}
{{#with input_configuration}}
{{#each labels}}
{{#if (length this)}}
{{#if (eq @root.desc_labels 0)}}
{{assign 'desc_labels' 1~}}
/* Aliases of channels labels */
{{/if}}{{!desc_labels~}}
{{#if (eq @root.current_layer 'HAL')}}
{{@root._define_}} {{uppercase this}}_CHANNEL  HAL_LPTIM_CHANNEL_{{@root.channel_id}}
{{else}}
{{@root._define_}} {{uppercase this}}_CHANNEL  LL_LPTIM_CHANNEL_CH{{@root.channel_id}}
{{/if}}{{!HAL~}}
{{/if}}{{!length~}}
{{/each}}{{!labels~}}
{{/with}}{{!input_configuration~}}
{{/each}}{{!channels~}}

{{helper_gpio_generate_aliases @root.pinoutAPI @root.current_resource @root.current_layer~}}

  {{~assign 'labels' (arrayify '')~}}
  {{#if (and info.labels (gt (length info.labels) 0))}}
    {{~assign 'labels' info.labels~}}
    {{~assign 'found_irq' false~}}
    {{~assign 'lptim_needs' 'undefined'~}}
  {{/if}}
  {{~assign 'labels' (helper_common_concatenate_elt_in_array name @root.labels)~}}
  {{#with system.nvic}}
    {{#if enable_interruption_global}}
      {{~assign 'lptim_needs' (helper_common_concatenate_needs nvic_config_global.needs @root.lptim_needs)~}}
    {{/if}}
    {{> CORTEX fct='cortex_create_aliases' hw_resource=@root.current_resource labels=@root.labels needs=@root.lptim_needs}}
  {{/with}}
{{/each}}
/* Exported macros -----------------------------------------------------------*/
/* Exported variables --------------------------------------------------------*/
/* Exported functions ------------------------------------------------------- */

{{assign 'current_index' 0~}}
{{assign 'hal_handle_lptim_exist' 0~}}
{{#each @root.instances}}
  {{#if (eq @root.strategy "SW")}}
    {{~assign 'lptim_cxt' (@root.SWConfigurationAPI.getSwInstanceConfiguration this)~}}
    {{~assign 'current_resource' (@root.peripheralsResourceManagerAPI.getPeripheralBoundToSoftwareInstance this)~}}
    {{~assign 'current_layer' @root.lptim_cxt.info.layer~}}
    {{~assign 'current_index' (helper_common_get_index @root.current_resource)~}}
  {{else}}
    {{~assign 'current_layer' info.layer~}}
  {{/if}}
/******************************************************************************/
/* Exported functions for SW instance{{index}} in {{@root.current_layer}} layer */
/******************************************************************************/
{{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer @root.current_index)~}}
{{assign 'current_index' (add @root.current_index 1)~}}
/**
  * @brief {{@root.fct_name}} init function
  * This function configures the hardware resources used in this example
  * @retval pointer to handle or NULL in case of failure
  */
{{#if (eq @root.current_layer 'HAL')}}
hal_lptim_handle_t *{{@root.fct_name}}_init(void);
{{else}}
LPTIM_TypeDef *{{@root.fct_name}}_init(void);
{{/if}}

/**
  * @brief  De-initialize {{@root.fct_name}} instance and return it.
  */
void {{@root.fct_name}}_deinit(void);

{{#if (eq @root.current_layer 'HAL')}}
{{#if (eq @root.hal_handle_lptim_exist 0)}}
{{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer undefined)~}}
/**
  * @brief  Get the {{@root.fct_name}} object.
  * @retval Pointer on the {{@root.fct_name}} Handle
  */
hal_lptim_handle_t *{{@root.fct_name}}_gethandle(void);
{{assign 'hal_handle_lptim_exist' 1~}}
{{/if}}
{{/if}}
{{#if (eq @root.current_layer 'LL')}}

{{> DMA_LL fct='get_dma_lli_reg' resource=@root.dma_resource strategy=@root.strategy type='prototype'}}
{{/if}} 
{{/each}}
{{> CORTEX fct='generate_irqhandler' type='prototype' component='LPTIM'}}
